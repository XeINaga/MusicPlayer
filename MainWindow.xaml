<Window
    x:Class="MusicPlayer.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MusicPlayer"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives"
    xmlns:services="using:MusicPlayer.Services"
    xmlns:models="using:MusicPlayer.Models"
    Title="音乐播放器">

    <Grid x:Name="RootGrid" Background="{ThemeResource AppBackground}" RequestedTheme="Light" KeyDown="MainWindow_KeyDown">

        <Grid.Resources>
            <services:TimeSpanConverter x:Key="TimeSpanConverter" />
            <services:CurrentTrackBrushConverter x:Key="CurrentTrackBrush" />
            <SolidColorBrush x:Key="QqGreen" Color="#31c27c" />
            <!-- Surface, text, navigation and button colours now live in
                 Themes/SukiTheme.xaml inside ThemeDictionaries, so both light and
                 dark are supported.

                 QqGreen and AccentGlow deliberately stay here: ApplyAccentColor()
                 looks them up in this very dictionary and mutates their Color at
                 runtime from the saved setting. -->

            <!-- Accent (primary) button resources: the WinUI built-in
                 AccentButtonStyle (used by CirclePlayStyle below) reads these
                 for its normal/hover/pressed states. EchoMusic look = white
                 disc with an ink glyph in both themes. -->
            <LinearGradientBrush x:Key="AccentButtonBackground" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#ffffff" Offset="0" />
                <GradientStop Color="#fdfdfd" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="AccentButtonBackgroundPointerOver" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#f6f6f8" Offset="0" />
                <GradientStop Color="#f2f2f5" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="AccentButtonBackgroundPressed" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#ececef" Offset="0" />
                <GradientStop Color="#e8e8ec" Offset="1" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="AccentButtonForeground" Color="#1d1d1f" />
            <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#000000" />
            <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#3a3a44" />
            <SolidColorBrush x:Key="AccentButtonBorderBrush" Color="#e5e5ea" />
            <SolidColorBrush x:Key="AccentButtonBorderBrushPointerOver" Color="#d8d8de" />
            <SolidColorBrush x:Key="AccentButtonBorderBrushPressed" Color="#c9c9d1" />

            <LinearGradientBrush x:Key="AccentGlow" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#ef4444" Offset="0" />
                <GradientStop Color="#f97316" Offset="1" />
            </LinearGradientBrush>

            <Style x:Key="NavButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{ThemeResource TextPrimary}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="Padding" Value="12,9" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="CornerRadius" Value="{StaticResource RadiusMedium}" />
            </Style>

            <!-- EchoMusic-style section label between sidebar groups. -->
            <Style x:Key="NavGroupLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{ThemeResource TextSecondary}" />
                <Setter Property="Margin" Value="22,10,0,4" />
            </Style>

            <Style x:Key="ActionButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{ThemeResource ButtonBackground}" />
                <Setter Property="Foreground" Value="{ThemeResource TextPrimary}" />
                <Setter Property="BorderBrush" Value="{ThemeResource BorderSoft}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="14,7" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="CornerRadius" Value="{StaticResource RadiusMedium}" />
            </Style>

            <!-- Same visual weight as ActionButtonStyle, for the grouped
                 drop-down / split buttons in the content toolbar. -->
            <Style x:Key="ActionMenuButtonStyle" TargetType="controls:DropDownButton">
                <Setter Property="Background" Value="{ThemeResource ButtonBackground}" />
                <Setter Property="Foreground" Value="{ThemeResource TextPrimary}" />
                <Setter Property="BorderBrush" Value="{ThemeResource BorderSoft}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="14,7" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="CornerRadius" Value="{StaticResource RadiusMedium}" />
            </Style>
            <Style x:Key="ActionSplitButtonStyle" TargetType="controls:SplitButton">
                <Setter Property="Background" Value="{ThemeResource ButtonBackground}" />
                <Setter Property="Foreground" Value="{ThemeResource TextPrimary}" />
                <Setter Property="BorderBrush" Value="{ThemeResource BorderSoft}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="14,7" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="CornerRadius" Value="{StaticResource RadiusMedium}" />
            </Style>

            <!-- Primary transport play button: EchoMusic's white disc with an
                 ink glyph and a hairline border (theme-aware via PlayBtn*). -->
            <Style x:Key="CirclePlayStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
                <Setter Property="Background" Value="{ThemeResource PlayBtnBg}" />
                <Setter Property="Foreground" Value="{ThemeResource PlayBtnFg}" />
                <Setter Property="BorderBrush" Value="{ThemeResource PlayBtnBorder}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="20" />
                <Setter Property="Width" Value="40" />
                <Setter Property="Height" Value="40" />
            </Style>

            <Style x:Key="GhostIconButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{ThemeResource TextPrimary}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="8" />
                <Setter Property="CornerRadius" Value="{StaticResource RadiusSmall}" />
            </Style>

            <!-- Toggle buttons whose CHECKED state follows the runtime accent
                 (the system default paints them with the OS accent colour,
                 which clashes with the app accent). Works for the pill-shaped
                 multi-select button and the round 词/穿 chips alike. -->
            <Style x:Key="AccentToggleStyle" TargetType="primitives:ToggleButton">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{ThemeResource TextPrimary}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="BorderBrush" Value="{ThemeResource BorderSoft}" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="primitives:ToggleButton">
                            <Grid x:Name="Root"
                                  Background="{TemplateBinding Background}"
                                  BorderBrush="{TemplateBinding BorderBrush}"
                                  BorderThickness="{TemplateBinding BorderThickness}"
                                  CornerRadius="{TemplateBinding CornerRadius}">
                                <ContentPresenter x:Name="Content"
                                                  Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Foreground="{TemplateBinding Foreground}" />
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Background" Value="{ThemeResource NavHover}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Background" Value="{ThemeResource NavHover}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="Content.Foreground" Value="{ThemeResource TextMuted}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                    <VisualStateGroup x:Name="CheckStates">
                                        <VisualState x:Name="Checked">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Background" Value="{StaticResource QqGreen}" />
                                                <Setter Target="Root.BorderBrush" Value="{StaticResource QqGreen}" />
                                                <Setter Target="Content.Foreground" Value="White" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="CheckedPointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Background" Value="{StaticResource QqGreen}" />
                                                <Setter Target="Root.BorderBrush" Value="{StaticResource QqGreen}" />
                                                <Setter Target="Content.Foreground" Value="White" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="CheckedPressed">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Background" Value="{StaticResource QqGreen}" />
                                                <Setter Target="Root.BorderBrush" Value="{StaticResource QqGreen}" />
                                                <Setter Target="Content.Foreground" Value="White" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Indeterminate" />
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Settings section card styles (SettingsCard/SettingsCardTitle/
                 SettingsHint) now live in Themes/SukiTheme.xaml — shared with
                 the SoundEffectWindow panel. -->

            <DataTemplate x:Key="TrackCardTemplate">
                <!-- EchoMusic album card: white raised card, soft border. -->
                <Grid Width="172" Margin="8,8,8,10" RightTapped="TrackItem_RightTapped">
                    <Grid.ContextFlyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="打开所在文件夹" Click="OpenContainingFolder_Click">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE838;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="播放次数清零" Click="ClearPlayCount_Click" />
                            <MenuFlyoutItem Text="选择歌词文件..." Click="AssignLyric_Click" />
                            <MenuFlyoutItem Text="清除手动指定的歌词" Click="ClearLyric_Click" />
                        </MenuFlyout>
                    </Grid.ContextFlyout>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Background="{ThemeResource CardBg}" BorderBrush="{ThemeResource BorderSoft}"
                            BorderThickness="1" CornerRadius="14" Grid.RowSpan="3" />

                    <Grid Grid.Row="0" Margin="8" Height="156" PointerEntered="Card_PointerEntered" PointerExited="Card_PointerExited">
                        <Border Width="156" Height="156" CornerRadius="12" Background="{ThemeResource CardPlaceholder}">
                            <Image Source="{Binding Cover}" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <Border x:Name="Dim" Width="156" Height="156" CornerRadius="12" Background="#000000" Opacity="0">
                            <!-- Ease the hover dim instead of snapping to it. -->
                            <Border.OpacityTransition>
                                <ScalarTransition Duration="0:0:0.18" />
                            </Border.OpacityTransition>
                        </Border>

                        <Button x:Name="CardFavBtn" Style="{StaticResource GhostIconButtonStyle}"
                                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8,8,0,0"
                                Width="30" Height="30" Click="FavoriteToggle_Click">
                            <FontIcon x:Name="CardFavIcon" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                      Foreground="{ThemeResource TextSecondary}" Loaded="FavIcon_Loaded" DataContextChanged="FavIcon_DataContextChanged" />
                        </Button>

                        <Button x:Name="PlayBtn" Style="{StaticResource CirclePlayStyle}"
                                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,12,12"
                                Opacity="0" Click="CardPlay_Click">
                            <!-- Fade in on hover rather than popping in. -->
                            <Button.OpacityTransition>
                                <ScalarTransition Duration="0:0:0.18" />
                            </Button.OpacityTransition>
                            <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE102;" FontSize="17" />
                        </Button>
                    </Grid>

                    <TextBlock Grid.Row="1" Text="{Binding Title}" Margin="12,4,12,0" FontSize="14"
                               FontWeight="SemiBold" Foreground="{ThemeResource TextPrimary}"
                               TextTrimming="CharacterEllipsis" MaxLines="1" />
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="4" Margin="12,3,12,10">
                        <TextBlock Text="{Binding Artist}" FontSize="12"
                                   Foreground="{ThemeResource TextSecondary}" TextTrimming="CharacterEllipsis" MaxLines="1" />
                        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE768;" FontSize="10"
                                  Foreground="{ThemeResource TextSecondary}" Opacity="0.7" Margin="6,1,0,0"
                                  ToolTipService.ToolTip="播放次数" />
                        <TextBlock Text="{Binding PlayCount}" FontSize="11"
                                   Foreground="{ThemeResource TextSecondary}" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="TrackRowTemplate">
                <Grid Height="60" Margin="8,3,16,3" CornerRadius="10" ColumnSpacing="14"
                      RightTapped="TrackItem_RightTapped"
                      PointerEntered="TrackRow_PointerEntered" PointerExited="TrackRow_PointerExited">
                    <Grid.ContextFlyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="打开所在文件夹" Click="OpenContainingFolder_Click">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE838;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="播放次数清零" Click="ClearPlayCount_Click" />
                            <MenuFlyoutItem Text="选择歌词文件..." Click="AssignLyric_Click" />
                            <MenuFlyoutItem Text="清除手动指定的歌词" Click="ClearLyric_Click" />
                        </MenuFlyout>
                    </Grid.ContextFlyout>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="48" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Width="48" Height="48">
                        <Border Background="{ThemeResource Surface3}" CornerRadius="{StaticResource RadiusSmall}" />
                        <FontIcon Glyph="&#xE8D6;" FontSize="14" Foreground="{ThemeResource TextSecondary}"
                                  Opacity="0.45" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Image Source="{Binding Cover}" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{Binding IsCurrent, Converter={StaticResource CurrentTrackBrush}, ConverterParameter={StaticResource QqGreen}}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Artist}" FontSize="12" Foreground="{ThemeResource TextSecondary}"
                                   TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding Album}" Foreground="{ThemeResource TextSecondary}" FontSize="12"
                               VerticalAlignment="Center" MaxWidth="170" TextTrimming="CharacterEllipsis" Margin="0,0,18,0" />
                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Margin="0,0,18,0"
                                ToolTipService.ToolTip="播放次数">
                        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE768;" FontSize="11"
                                  Foreground="{ThemeResource TextSecondary}" />
                        <TextBlock Text="{Binding PlayCount}" Foreground="{ThemeResource TextSecondary}" FontSize="12" />
                    </StackPanel>
                    <TextBlock Grid.Column="4" Text="{Binding Duration, Converter={StaticResource TimeSpanConverter}}"
                               Foreground="{ThemeResource TextSecondary}" FontSize="12" VerticalAlignment="Center" />
                    <Button x:Name="RowPlayNextBtn" Grid.Column="5" Style="{StaticResource GhostIconButtonStyle}"
                            Width="34" Height="34" VerticalAlignment="Center" Opacity="0"
                            Click="TrackPlayNext_Click" ToolTipService.ToolTip="下一首播放">
                        <Button.OpacityTransition>
                            <ScalarTransition Duration="0:0:0.15" />
                        </Button.OpacityTransition>
                        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE101;" FontSize="14"
                                  Foreground="{ThemeResource TextPrimary}" />
                    </Button>
                    <Button x:Name="RowFavBtn" Grid.Column="6" Style="{StaticResource GhostIconButtonStyle}"
                            Width="34" Height="34" VerticalAlignment="Center"
                            Click="FavoriteToggle_Click">
                        <FontIcon x:Name="RowFavIcon" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                  Foreground="{ThemeResource TextSecondary}" Loaded="FavIcon_Loaded" DataContextChanged="FavIcon_DataContextChanged" />
                    </Button>
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="AlbumCardTemplate">
                <Grid Width="180" Margin="8,8,8,10" Tapped="AlbumCard_Tapped"
                      Background="Transparent" CornerRadius="14"
                      PointerEntered="AlbumCard_PointerEntered" PointerExited="AlbumCard_PointerExited">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Background="{ThemeResource CardBg}" BorderBrush="{ThemeResource BorderSoft}"
                            BorderThickness="1" CornerRadius="14" Grid.RowSpan="3" />

                    <Grid Grid.Row="0" Margin="8" Height="164">
                        <Border Width="164" Height="164" CornerRadius="12"
                                Background="{ThemeResource CardPlaceholder}">
                            <Image Source="{Binding Cover}" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>

                    <TextBlock Grid.Row="1" Text="{Binding Name}" Margin="12,4,12,0" FontSize="14"
                               FontWeight="SemiBold" Foreground="{ThemeResource TextPrimary}"
                               TextTrimming="CharacterEllipsis" MaxLines="1" />
                    <TextBlock Grid.Row="2" Text="{Binding TrackCount}" Margin="12,3,12,10" FontSize="12"
                               Foreground="{ThemeResource TextSecondary}" />
                </Grid>
            </DataTemplate>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title bar strip: content extends into the caption area (see
             ExtendsContentIntoTitleBar / SetTitleBar in code-behind). The whole
             strip is the drag region; system caption buttons sit on the right. -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="48" Background="Transparent">
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="16,0,0,0" VerticalAlignment="Center">
                <Image x:Name="TitleAppIcon" Width="20" Height="20" />
                <TextBlock Text="MusicPlayer" FontSize="14" FontWeight="SemiBold"
                           Foreground="{ThemeResource TextPrimary}" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- Body -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="224" />
                <ColumnDefinition x:Name="CenterCol" Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left navigation sidebar (EchoMusic style: profile card on top,
                 grouped nav, playlist list) -->
            <Grid Grid.Column="0" Background="{ThemeResource NavRailBg}" BorderBrush="{ThemeResource BorderSoft}" BorderThickness="0,0,1,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Profile-style card: app avatar, name, and the settings
                     gear exactly where EchoMusic puts it. The gear keeps the
                     NavSettings x:Name so selection code keeps working. -->
                <Border Grid.Row="0" Margin="12,12,12,4" Padding="12,10"
                        Background="{ThemeResource CardBg}" BorderBrush="{ThemeResource BorderSoft}"
                        BorderThickness="1" CornerRadius="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="40" Height="40" CornerRadius="20"
                                Background="{ThemeResource Surface3}" BorderBrush="{ThemeResource BorderSoft}" BorderThickness="1">
                            <Image x:Name="ProfileAvatarImage" Stretch="Uniform" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" Spacing="1">
                            <TextBlock Text="MusicPlayer" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextPrimary}" />
                            <TextBlock x:Name="ProfileSubtitle" Text="本地音乐库" FontSize="11"
                                       Foreground="{ThemeResource TextSecondary}" />
                        </StackPanel>
                        <Button x:Name="NavSettings" Grid.Column="2" Click="NavSettings_Click" Style="{StaticResource GhostIconButtonStyle}"
                                Width="34" Height="34" Padding="0" VerticalAlignment="Center"
                                ToolTipService.ToolTip="设置">
                            <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE713;" FontSize="15"
                                      Foreground="{ThemeResource TextSecondary}" />
                        </Button>
                    </Grid>
                </Border>

                <StackPanel Grid.Row="1" Spacing="2" Margin="10,6,10,0">
                    <TextBlock Text="我的乐库" Style="{StaticResource NavGroupLabel}" />
                    <Button x:Name="NavRecent" Click="NavRecent_Click" Style="{StaticResource NavButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE823;" FontSize="16" />
                            <TextBlock Text="最近播放" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="NavLocal" Click="NavLocal_Click" Style="{StaticResource NavButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE8B7;" FontSize="16" />
                            <TextBlock Text="本地音乐" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="NavFavorites" Click="NavFavorites_Click" Style="{StaticResource NavButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE734;" FontSize="16" />
                            <TextBlock Text="我的收藏" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="NavMostPlayed" Click="NavMostPlayed_Click" Style="{StaticResource NavButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE823;" FontSize="16" />
                            <TextBlock Text="最常播放" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="NavArtists" Click="NavArtists_Click" Style="{StaticResource NavButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE77B;" FontSize="16" />
                            <TextBlock Text="歌手" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="NavAlbums" Click="NavAlbums_Click" Style="{StaticResource NavButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE8D2;" FontSize="16" />
                            <TextBlock Text="专辑" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <TextBlock Text="工具" Style="{StaticResource NavGroupLabel}" Margin="12,12,0,4" />
                    <Button x:Name="NavLyricFill" Click="NavLyricFill_Click" Style="{StaticResource NavButtonStyle}"
                            ToolTipService.ToolTip="批量下载缺失的歌词并补齐翻译 / 罗马音">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE8A5;" FontSize="16" />
                            <TextBlock Text="歌词补全" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <Grid Grid.Row="2" Margin="10,4,10,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="12,8,4,6">
                        <TextBlock Text="我的歌单" Foreground="{ThemeResource TextSecondary}" FontSize="12" VerticalAlignment="Center" />
                        <Button x:Name="BtnNewPlaylist" HorizontalAlignment="Right" Width="30" Height="30" Padding="0"
                                Background="Transparent" BorderThickness="0" CornerRadius="15"
                                Click="BtnNewPlaylist_Click" ToolTipService.ToolTip="新建歌单">
                            <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE710;" FontSize="14"
                                      Foreground="{ThemeResource TextSecondary}" />
                        </Button>
                    </Grid>
                    <ListView x:Name="PlaylistsList" Grid.Row="1" Background="Transparent" BorderThickness="0"
                              IsItemClickEnabled="True" ItemClick="PlaylistsList_ItemClick" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="10" Margin="6,5" RightTapped="PlaylistItem_RightTapped">
                                    <Border Width="26" Height="26" CornerRadius="7" Background="{ThemeResource Surface2}">
                                        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE93C;" FontSize="11"
                                                  Foreground="{ThemeResource TextSecondary}" HorizontalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="{Binding Name}" Foreground="{ThemeResource TextPrimary}" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Tracks.Count}" Foreground="{ThemeResource TextSecondary}" FontSize="11" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Grid>

            <!-- Center content area (transparent: Mica / RootGrid fallback shows through) -->
            <Grid Grid.Column="1" x:Name="RightArea">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="94" />
                </Grid.RowDefinitions>

                <Grid x:Name="CenterGrid">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="26,20,26,4" Spacing="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <TextBlock x:Name="ContentTitle" Text="本地音乐" FontSize="26" FontWeight="Bold"
                                       Foreground="{ThemeResource TextPrimary}" VerticalAlignment="Center" />
                            <TextBlock x:Name="ContentSubtitle" Text="" FontSize="13"
                                       Foreground="{ThemeResource TextSecondary}" VerticalAlignment="Center"
                                       Margin="2,4,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" x:Name="LibraryHeader" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <ComboBox x:Name="ViewCombo" Width="96"
                                      SelectionChanged="ViewCombo_SelectionChanged" Visibility="Collapsed">
                                <ComboBoxItem Content="大图标" />
                                <ComboBoxItem Content="列表" />
                            </ComboBox>
                            <ComboBox x:Name="SortCombo" Width="112"
                                      SelectionChanged="SortCombo_SelectionChanged" Visibility="Collapsed">
                                <ComboBoxItem Content="默认顺序" />
                                <ComboBoxItem Content="标题" />
                                <ComboBoxItem Content="歌手" />
                                <ComboBoxItem Content="专辑" />
                                <ComboBoxItem Content="添加时间" />
                                <ComboBoxItem Content="时长" />
                                <ComboBoxItem Content="播放次数" />
                            </ComboBox>
                            <TextBox x:Name="SearchBox" Width="220" Height="34" PlaceholderText="搜索歌曲、歌手、专辑"
                                     Background="{ThemeResource Surface2}" Foreground="{ThemeResource TextPrimary}"
                                     BorderBrush="{ThemeResource BorderSoft}" BorderThickness="1" CornerRadius="{StaticResource RadiusPill}"
                                     VerticalAlignment="Center" TextChanged="SearchBox_TextChanged" />
                        </StackPanel>
                    </Grid>
                    <StackPanel x:Name="ContentActions" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Left">
                        <!-- 添加 / 导入：所有入口都保留，只是收进一个下拉 -->
                        <controls:DropDownButton x:Name="BtnAddMenu" Content="添加" Style="{StaticResource ActionMenuButtonStyle}"
                                                 Visibility="Collapsed" ToolTipService.ToolTip="添加本地音频，或从 M3U 播放列表导入">
                            <controls:DropDownButton.Flyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem x:Name="BtnAddFile" Text="添加文件" Click="BtnAddFile_Click" />
                                    <MenuFlyoutItem x:Name="BtnAddFolderRecursive" Text="添加文件夹（含子文件夹）" Click="BtnAddFolderRecursive_Click" />
                                    <MenuFlyoutItem x:Name="BtnAddFolderFlat" Text="仅当前文件夹" Click="BtnAddFolderFlat_Click" />
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem x:Name="BtnOpenList" Text="从 M3U 导入列表" Click="BtnOpenList_Click" />
                                </MenuFlyout>
                            </controls:DropDownButton.Flyout>
                        </controls:DropDownButton>

                        <!-- 列表维护 -->
                        <controls:DropDownButton x:Name="BtnListMenu" Content="列表" Style="{StaticResource ActionMenuButtonStyle}"
                                                 Visibility="Collapsed" ToolTipService.ToolTip="导出 M3U、清空列表或清空播放记录">
                            <controls:DropDownButton.Flyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem x:Name="BtnSaveList" Text="导出为 M3U" Click="BtnSaveList_Click" />
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem x:Name="BtnClear" Text="清空列表" Click="BtnClear_Click" />
                                    <MenuFlyoutItem x:Name="BtnClearRecent" Text="清空播放记录" Click="BtnClearRecent_Click" />
                                </MenuFlyout>
                            </controls:DropDownButton.Flyout>
                        </controls:DropDownButton>

                        <!-- 一键补全歌词：左半边立即执行，右半边箭头里是选项 -->
                        <controls:SplitButton x:Name="BtnBatchLyrics" Content="补全歌词" Style="{StaticResource ActionSplitButtonStyle}"
                                              Visibility="Collapsed" Click="BtnBatchLyrics_Click"
                                              ToolTipService.ToolTip="为缺少歌词的歌曲在线下载歌词，并为已有歌词补齐翻译/罗马音；点右侧箭头可设置歌词来源与补全内容">
                            <controls:SplitButton.Flyout>
                                <MenuFlyout>
                                    <MenuFlyoutSubItem Text="歌词来源">
                                        <controls:RadioMenuFlyoutItem x:Name="LyricSrcAuto" Text="自动（网易云 → QQ → LRCLIB）"
                                                                      GroupName="LyricSource" Click="LyricSourceOption_Click" />
                                        <controls:RadioMenuFlyoutItem x:Name="LyricSrcNetEase" Text="网易云音乐"
                                                                      GroupName="LyricSource" Click="LyricSourceOption_Click" />
                                        <controls:RadioMenuFlyoutItem x:Name="LyricSrcQq" Text="QQ 音乐"
                                                                      GroupName="LyricSource" Click="LyricSourceOption_Click" />
                                        <controls:RadioMenuFlyoutItem x:Name="LyricSrcLrclib" Text="LRCLIB"
                                                                      GroupName="LyricSource" Click="LyricSourceOption_Click" />
                                    </MenuFlyoutSubItem>
                                    <MenuFlyoutSubItem Text="补全内容">
                                        <controls:RadioMenuFlyoutItem x:Name="LyricFillAll" Text="全部（原文 + 翻译 + 罗马音）"
                                                                      GroupName="LyricFillMode" Click="LyricFillOption_Click" />
                                        <controls:RadioMenuFlyoutItem x:Name="LyricFillMain" Text="仅原文歌词"
                                                                      GroupName="LyricFillMode" Click="LyricFillOption_Click" />
                                        <controls:RadioMenuFlyoutItem x:Name="LyricFillExtras" Text="仅补充翻译 / 罗马音"
                                                                      GroupName="LyricFillMode" Click="LyricFillOption_Click" />
                                    </MenuFlyoutSubItem>
                                </MenuFlyout>
                            </controls:SplitButton.Flyout>
                        </controls:SplitButton>

                        <!-- 歌单操作 -->
                        <controls:DropDownButton x:Name="BtnPlaylistMenu" Content="歌单" Style="{StaticResource ActionMenuButtonStyle}"
                                                 Visibility="Collapsed" ToolTipService.ToolTip="播放、添加歌曲、重命名或删除此歌单">
                            <controls:DropDownButton.Flyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem x:Name="BtnPlayPlaylist" Text="播放歌单" Click="BtnPlayPlaylist_Click" />
                                    <MenuFlyoutItem x:Name="BtnAddToPlaylist" Text="添加歌曲" Click="BtnAddToPlaylist_Click" />
                                    <MenuFlyoutItem x:Name="BtnRenamePlaylist" Text="重命名" Click="BtnRenamePlaylist_Click" />
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem x:Name="BtnDeletePlaylist" Text="删除歌单" Click="BtnDeletePlaylist_Click" />
                                </MenuFlyout>
                            </controls:DropDownButton.Flyout>
                        </controls:DropDownButton>

                        <primitives:ToggleButton x:Name="BtnSelectMode" Content="多选" Style="{StaticResource AccentToggleStyle}"
                                                 CornerRadius="{StaticResource RadiusMedium}" Padding="14,7" FontSize="12"
                                                 Visibility="Collapsed" Checked="BtnSelectMode_Checked" Unchecked="BtnSelectMode_Unchecked"
                                                 ToolTipService.ToolTip="进入多选模式，批量添加到歌单（Ctrl+A 全选）" />

                        <!-- 批量操作 -->
                        <controls:DropDownButton x:Name="BtnSelectMenu" Content="批量操作" Style="{StaticResource ActionMenuButtonStyle}"
                                                 Visibility="Collapsed" ToolTipService.ToolTip="对已选中的歌曲执行批量操作">
                            <controls:DropDownButton.Flyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem x:Name="BtnSelectAll" Text="全选" Click="BtnSelectAll_Click" />
                                    <MenuFlyoutItem x:Name="BtnSelectNone" Text="全不选" Click="BtnSelectNone_Click" />
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem x:Name="BtnBatchAdd" Text="添加到歌单" Click="BtnBatchAdd_Click" />
                                    <MenuFlyoutItem x:Name="BtnBatchExport" Text="导出选中" Click="BtnBatchExport_Click" />
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem x:Name="BtnBatchClearCount" Text="播放次数清零" Click="BtnBatchClearCount_Click"
                                                    ToolTipService.ToolTip="把选中歌曲的播放次数归零（用于修正错误计数）" />
                                    <MenuFlyoutItem x:Name="BtnBatchRemove" Text="从列表中移除" Click="BtnBatchRemove_Click" />
                                </MenuFlyout>
                            </controls:DropDownButton.Flyout>
                        </controls:DropDownButton>
                    </StackPanel>
                </StackPanel>

                <Grid Grid.Row="1">
                    <GridView x:Name="TrackGrid" Background="Transparent" BorderThickness="0" Margin="12,4,12,12"
                              SelectionMode="None" IsItemClickEnabled="False"
                              ItemTemplate="{StaticResource TrackCardTemplate}"
                              DoubleTapped="TrackGrid_DoubleTapped"
                              AllowDrop="True" DragOver="TrackGrid_DragOver" Drop="TrackGrid_Drop">
                    </GridView>

                    <ListView x:Name="TrackList" Background="Transparent" BorderThickness="0" Margin="12,4,12,12"
                              Visibility="Collapsed" SelectionMode="None" IsItemClickEnabled="False"
                              ItemTemplate="{StaticResource TrackRowTemplate}"
                              DoubleTapped="TrackList_DoubleTapped"
                              DragItemsCompleted="TrackList_DragItemsCompleted"
                              AllowDrop="True" DragOver="TrackGrid_DragOver" Drop="TrackGrid_Drop">
                    </ListView>

                    <GridView x:Name="AlbumGrid" Background="Transparent" BorderThickness="0" Margin="12,4,12,12"
                              Visibility="Collapsed" SelectionMode="None" IsItemClickEnabled="False"
                              ItemTemplate="{StaticResource AlbumCardTemplate}">
                    </GridView>

                    <StackPanel x:Name="AlbumFilterBar" Orientation="Horizontal" Spacing="8"
                                Visibility="Collapsed" Margin="12,4,12,0">
                        <Button x:Name="BtnAlbumBack" Click="BtnAlbumBack_Click"
                                Style="{StaticResource ActionButtonStyle}"
                                ToolTipService.ToolTip="返回专辑列表">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE72B;" FontSize="14" />
                                <TextBlock Text="返回专辑" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <TextBlock x:Name="AlbumFilterLabel" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextPrimary}" VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBlock x:Name="EmptyHint" Text="还没有歌曲：点击上方「添加文件」或「添加文件夹」，或直接把音频文件拖进来"
                               Foreground="{ThemeResource TextSecondary}" FontSize="14" HorizontalAlignment="Center"
                               VerticalAlignment="Center" Visibility="Collapsed" />

                    <!-- Artist browse: grid of artist cards (name + track count) -->
                    <Grid x:Name="ArtistBrowsePanel" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Button x:Name="BtnArtistBack" Grid.Row="0" Margin="22,6,22,6"
                                HorizontalAlignment="Left" Style="{StaticResource ActionButtonStyle}"
                                Click="BtnArtistBack_Click">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE72B;" FontSize="13"
                                          Foreground="{ThemeResource TextPrimary}" />
                                <TextBlock Text="返回歌手列表" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <GridView x:Name="ArtistGrid" Grid.Row="1" Background="Transparent" BorderThickness="0" Margin="12,4,12,12"
                                  SelectionMode="None" IsItemClickEnabled="True" ItemClick="ArtistGrid_ItemClick">
                            <GridView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Width="164" Margin="10,10,10,8">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="164" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Border Grid.Row="0" Width="164" Height="164" CornerRadius="{StaticResource RadiusLarge}" Background="{ThemeResource CardPlaceholder}">
                                            <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE77B;" FontSize="52"
                                                      Foreground="{ThemeResource TextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Grid.Row="1" Text="{Binding ArtistName}" Margin="2,9,2,0" FontSize="14"
                                                   FontWeight="SemiBold" Foreground="{ThemeResource TextPrimary}"
                                                   TextTrimming="CharacterEllipsis" MaxLines="1" />
                                        <TextBlock Grid.Row="2" Text="{Binding TrackCountText}" Margin="2,3,2,0" FontSize="12"
                                                   Foreground="{ThemeResource TextSecondary}" />
                                    </Grid>
                                </DataTemplate>
                            </GridView.ItemTemplate>
                        </GridView>
                    </Grid>

                    <ScrollViewer x:Name="SettingsScroll" Visibility="Collapsed" Margin="22,6,22,14">
                        <StackPanel x:Name="SettingsPanel" Spacing="14" MaxWidth="720" HorizontalAlignment="Left">

                            <!-- ============ 外观 ============ -->
                            <Border Style="{StaticResource SettingsCard}">
                                <StackPanel>
                                    <TextBlock Text="外观" Style="{StaticResource SettingsCardTitle}" />

                                    <Grid Padding="0,12" ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                            <TextBlock Text="主题模式" FontSize="14" Foreground="{ThemeResource TextPrimary}" />
                                            <TextBlock Text="选择您喜欢的主题外观" Style="{StaticResource SettingsHint}" />
                                        </StackPanel>
                                        <ComboBox x:Name="ThemeModeCombo" Grid.Column="1" Width="180" VerticalAlignment="Center"
                                                  SelectionChanged="ThemeModeCombo_SelectionChanged">
                                            <ComboBoxItem Content="深色" />
                                            <ComboBoxItem Content="浅色" />
                                        </ComboBox>
                                    </Grid>
                                    <Border Height="1" Background="{ThemeResource BorderSoft}" Opacity="0.5" />

                                    <Grid Padding="0,12" ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                            <TextBlock Text="显示标题优先用文件名" FontSize="14" Foreground="{ThemeResource TextPrimary}" />
                                            <TextBlock Text="列表显示文件名中的标题而不是内嵌标签（内嵌标签有误时使用，切换后刷新曲库）" Style="{StaticResource SettingsHint}" />
                                        </StackPanel>
                                        <ToggleSwitch x:Name="TitlePreferFilenameToggle" Grid.Column="1" VerticalAlignment="Center"
                                                      OffContent="" OnContent="" Toggled="TitlePreferFilenameToggle_Toggled"
                                                      ToolTipService.ToolTip="开启后列表显示音频文件名中的标题，而不是文件内嵌标签里的标题。" />
                                    </Grid>
                                    <Border Height="1" Background="{ThemeResource BorderSoft}" Opacity="0.5" />

                                    <Grid Padding="0,12" ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                            <TextBlock Text="主题色" FontSize="14" Foreground="{ThemeResource TextPrimary}" />
                                            <TextBlock Text="用于高亮、按钮、进度条等，点击色块修改" Style="{StaticResource SettingsHint}" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Width="44" Height="36" Padding="0" CornerRadius="10"
                                                Background="Transparent" BorderThickness="0" VerticalAlignment="Center">
                                            <Border x:Name="AccentSwatch" Width="24" Height="24" CornerRadius="12" Background="#ef4444" />
                                            <Button.Flyout>
                                                <Flyout>
                                                    <controls:ColorPicker x:Name="AccentColorPicker" ColorChanged="AccentColorPicker_ColorChanged" />
                                                </Flyout>
                                            </Button.Flyout>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- ============ 桌面歌词样式 ============ -->
                            <Border Style="{StaticResource SettingsCard}">
                                <StackPanel>
                                    <TextBlock Text="桌面歌词样式" Style="{StaticResource SettingsCardTitle}" />

                                    <Grid Padding="0,12" ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                            <TextBlock Text="桌面歌词大小" FontSize="14" Foreground="{ThemeResource TextPrimary}" />
                                            <TextBlock Text="拖动滑杆实时调整；罗马音和翻译行会按比例缩放" Style="{StaticResource SettingsHint}" />
                                        </StackPanel>
                                        <TextBlock x:Name="LyricFontSizeText" Text="24" Grid.Column="1" FontSize="14"
                                                   Foreground="{ThemeResource TextPrimary}" VerticalAlignment="Center" />
                                    </Grid>
                                    <Slider x:Name="LyricFontSlider" HorizontalAlignment="Stretch" Margin="0,0,0,12"
                                            Foreground="{StaticResource QqGreen}" ValueChanged="LyricFontSlider_ValueChanged" />
                                    <Border Background="{ThemeResource Surface2}" CornerRadius="{StaticResource RadiusSmall}" Padding="14,10"
                                            HorizontalAlignment="Left" Margin="0,0,0,12">
                                        <StackPanel Spacing="2">
                                            <TextBlock x:Name="LyricSizePreviewMain" Text="预览：桌面歌词" FontSize="24" />
                                            <TextBlock x:Name="LyricSizePreviewRoma" Text="pureryu: desktop lyrics" FontSize="13"
                                                       Opacity="0.55" />
                                        </StackPanel>
                                    </Border>
                                    <Border Height="1" Background="{ThemeResource BorderSoft}" Opacity="0.5" />

                                    <Grid Padding="0,12" ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                            <TextBlock Text="文字颜色" FontSize="14" Foreground="{ThemeResource TextPrimary}" />
                                            <TextBlock Text="桌面歌词与歌词面板的歌词文字颜色，点击色块修改" Style="{StaticResource SettingsHint}" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Width="44" Height="36" Padding="0" CornerRadius="10"
                                                Background="Transparent" BorderThickness="0" VerticalAlignment="Center">
                                            <Border x:Name="LyricColorSwatch" Width="24" Height="24" CornerRadius="12" Background="#ffffff" />
                                            <Button.Flyout>
                                                <Flyout>
                                                    <controls:ColorPicker x:Name="LyricColorPicker" ColorChanged="LyricColorPicker_ColorChanged" />
                                                </Flyout>
                                            </Button.Flyout>
                                        </Button>
                                    </Grid>
                                    <Border Height="1" Background="{ThemeResource BorderSoft}" Opacity="0.5" />

                                    <Grid Padding="0,12" ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                            <TextBlock Text="卡拉OK已播放颜色" FontSize="14" Foreground="{ThemeResource TextPrimary}" />
                                            <TextBlock Text="逐字歌词扫过部分的颜色，与桌面歌词同步" Style="{StaticResource SettingsHint}" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Width="44" Height="36" Padding="0" CornerRadius="10"
                                                Background="Transparent" BorderThickness="0" VerticalAlignment="Center">
                                            <Border x:Name="SungSwatch" Width="24" Height="24" CornerRadius="12" Background="#31c27c" />
                                            <Button.Flyout>
                                                <Flyout>
                                                    <controls:ColorPicker x:Name="SungColorPicker" ColorChanged="SungColorPicker_ColorChanged" />
                                                </Flyout>
                                            </Button.Flyout>
                                        </Button>
                                    </Grid>
                                    <Border Height="1" Background="{ThemeResource BorderSoft}" Opacity="0.5" />

                                    <Grid Padding="0,12" ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                            <TextBlock Text="卡拉OK未播放颜色" FontSize="14" Foreground="{ThemeResource TextPrimary}" />
                                            <TextBlock Text="逐字歌词尚未唱到部分的颜色，与桌面歌词同步" Style="{StaticResource SettingsHint}" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Width="44" Height="36" Padding="0" CornerRadius="10"
                                                Background="Transparent" BorderThickness="0" VerticalAlignment="Center">
                                            <Border x:Name="UnsungSwatch" Width="24" Height="24" CornerRadius="12" Background="#ffffff" />
                                            <Button.Flyout>
                                                <Flyout>
                                                    <controls:ColorPicker x:Name="UnsungColorPicker" ColorChanged="UnsungColorPicker_ColorChanged" />
                                                </Flyout>
                                            </Button.Flyout>
                                        </Button>
                                    </Grid>
                                    <Border Height="1" Background="{ThemeResource BorderSoft}" Opacity="0.5" />

                                    <Grid Padding="0,12" ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                            <TextBlock Text="歌词文件编码" FontSize="14" Foreground="{ThemeResource TextPrimary}" />
                                            <TextBlock Text="日文歌词乱码可尝试 Shift-JIS" Style="{StaticResource SettingsHint}" />
                                        </StackPanel>
                                        <ComboBox x:Name="LyricEncodingCombo" Grid.Column="1" Width="160" VerticalAlignment="Center"
                                                  SelectionChanged="LyricEncodingCombo_SelectionChanged">
                                            <ComboBoxItem Content="自动检测" />
                                            <ComboBoxItem Content="GBK" />
                                            <ComboBoxItem Content="Shift-JIS" />
                                            <ComboBoxItem Content="Big5" />
                                            <ComboBoxItem Content="UTF-8" />
                                        </ComboBox>
                                    </Grid>
                                    <Border Height="1" Background="{ThemeResource BorderSoft}" Opacity="0.5" />

                                    <Grid Padding="0,12" ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                            <TextBlock Text="歌词下载源" FontSize="14" Foreground="{ThemeResource TextPrimary}" />
                                            <TextBlock Text="自动 = 网易云 → QQ → LRCLIB 依次尝试；指定某一源时不回退" Style="{StaticResource SettingsHint}" />
                                        </StackPanel>
                                        <ComboBox x:Name="LyricSourceCombo" Grid.Column="1" Width="160" VerticalAlignment="Center"
                                                  SelectionChanged="LyricSourceCombo_SelectionChanged">
                                            <ComboBoxItem Content="自动" />
                                            <ComboBoxItem Content="网易云音乐" />
                                            <ComboBoxItem Content="QQ 音乐" />
                                            <ComboBoxItem Content="酷狗音乐" />
                                            <ComboBoxItem Content="LRCLIB" />
                                        </ComboBox>
                                    </Grid>
                                    <Border Height="1" Background="{ThemeResource BorderSoft}" Opacity="0.5" />

                                    <Grid Padding="0,12" ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                            <TextBlock Text="下载逐字歌词" FontSize="14" Foreground="{ThemeResource TextPrimary}" />
                                            <TextBlock Text="卡拉OK逐字（QQ QRC / 酷狗 KRC）；源没有逐字版本时自动回退普通 LRC" Style="{StaticResource SettingsHint}" />
                                        </StackPanel>
                                        <ToggleSwitch x:Name="WordLyricsToggle" Grid.Column="1" VerticalAlignment="Center"
                                                      OffContent="" OnContent="" Toggled="WordLyricsToggle_Toggled"
                                                      ToolTipService.ToolTip="开启后补全/下载歌词时优先保存逐字时间（.qrc/.krc 文件），歌词面板会高亮当前演唱到的字。" />
                                    </Grid>
                                    <Border Height="1" Background="{ThemeResource BorderSoft}" Opacity="0.5" />

                                    <Grid Padding="0,12" ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="3">
                                            <TextBlock Text="QQ音乐 Cookie（可选）" FontSize="14" Foreground="{ThemeResource TextPrimary}" />
                                            <TextBlock Text="QQ 已限制未登录搜索，粘贴 Cookie 后 QQ 源可用" Style="{StaticResource SettingsHint}" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBox x:Name="QqCookieBox" HorizontalAlignment="Stretch" Margin="0,0,0,12"
                                             PlaceholderText="浏览器登录 y.qq.com → F12 → 应用 → Cookie → 复制全部（含 qm_keyst/uin）"
                                             TextChanged="QqCookieBox_TextChanged" TextWrapping="Wrap" AcceptsReturn="False"
                                             MinHeight="52" MaxHeight="96" />
                                    <Border Height="1" Background="{ThemeResource BorderSoft}" Opacity="0.5" />

                                    <Grid Padding="0,12" ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                            <TextBlock Text="一键补全歌词写入的内容" FontSize="14" Foreground="{ThemeResource TextPrimary}" />
                                        </StackPanel>
                                        <ComboBox x:Name="LyricFillModeCombo" Grid.Column="1" Width="200" VerticalAlignment="Center"
                                                  SelectionChanged="LyricFillModeCombo_SelectionChanged">
                                            <ComboBoxItem Content="全部（原文 + 翻译 + 罗马音）" />
                                            <ComboBoxItem Content="仅原文歌词" />
                                            <ComboBoxItem Content="仅补充翻译 / 罗马音" />
                                        </ComboBox>
                                    </Grid>
                                    <Border Height="1" Background="{ThemeResource BorderSoft}" Opacity="0.5" />

                                    <Grid Padding="0,12" ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                            <TextBlock Text="背景不透明度" FontSize="14" Foreground="{ThemeResource TextPrimary}" />
                                            <TextBlock Text="0 = 完全透明" Style="{StaticResource SettingsHint}" />
                                        </StackPanel>
                                        <Slider x:Name="LyricOpacitySlider" Grid.Column="1" Width="220" VerticalAlignment="Center"
                                                Foreground="{StaticResource QqGreen}" ValueChanged="LyricOpacitySlider_ValueChanged" />
                                    </Grid>
                                    <Border Height="1" Background="{ThemeResource BorderSoft}" Opacity="0.5" />

                                    <Grid Padding="0,12" ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                            <TextBlock Text="加粗文字" FontSize="14" Foreground="{ThemeResource TextPrimary}" />
                                        </StackPanel>
                                        <ToggleSwitch x:Name="LyricBoldToggle" Grid.Column="1" VerticalAlignment="Center"
                                                      OffContent="" OnContent="" Toggled="LyricBoldToggle_Toggled" />
                                    </Grid>
                                    <Border Height="1" Background="{ThemeResource BorderSoft}" Opacity="0.5" />

                                    <Grid Padding="0,12" ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                            <TextBlock Text="对齐方式" FontSize="14" Foreground="{ThemeResource TextPrimary}" />
                                        </StackPanel>
                                        <ComboBox x:Name="LyricAlignCombo" Grid.Column="1" Width="140" VerticalAlignment="Center"
                                                  SelectionChanged="LyricAlignCombo_SelectionChanged">
                                            <ComboBoxItem Content="居中" />
                                            <ComboBoxItem Content="居左" />
                                        </ComboBox>
                                    </Grid>
                                    <Border Height="1" Background="{ThemeResource BorderSoft}" Opacity="0.5" />

                                    <Grid Padding="0,12" ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                            <TextBlock Text="歌词行顺序" FontSize="14" Foreground="{ThemeResource TextPrimary}" />
                                            <TextBlock Text="同步应用到桌面歌词" Style="{StaticResource SettingsHint}" />
                                        </StackPanel>
                                        <ComboBox x:Name="LyricLineOrderCombo" Grid.Column="1" Width="190" VerticalAlignment="Center"
                                                  SelectionChanged="LyricLineOrderCombo_SelectionChanged">
                                            <ComboBoxItem Content="原文 / 罗马音 / 翻译" />
                                            <ComboBoxItem Content="原文 / 翻译 / 罗马音" />
                                            <ComboBoxItem Content="罗马音 / 原文 / 翻译" />
                                            <ComboBoxItem Content="翻译 / 原文 / 罗马音" />
                                            <ComboBoxItem Content="罗马音 / 翻译 / 原文" />
                                            <ComboBoxItem Content="翻译 / 罗马音 / 原文" />
                                        </ComboBox>
                                    </Grid>
                                    <Border Height="1" Background="{ThemeResource BorderSoft}" Opacity="0.5" />

                                    <Grid Padding="0,12" ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                            <TextBlock Text="默认开启鼠标穿透" FontSize="14" Foreground="{ThemeResource TextPrimary}" />
                                            <TextBlock Text="鼠标点击会穿过歌词悬浮窗" Style="{StaticResource SettingsHint}" />
                                        </StackPanel>
                                        <ToggleSwitch x:Name="LyricClickThroughToggle" Grid.Column="1" VerticalAlignment="Center"
                                                      OffContent="" OnContent="" Toggled="LyricClickThroughToggle_Toggled" />
                                    </Grid>
                                    <Border Height="1" Background="{ThemeResource BorderSoft}" Opacity="0.5" />

                                    <Grid Padding="0,12" ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                            <TextBlock Text="竖排显示" FontSize="14" Foreground="{ThemeResource TextPrimary}" />
                                            <TextBlock Text="逐字纵向成列；全屏应用运行时自动隐藏桌面歌词" Style="{StaticResource SettingsHint}" />
                                        </StackPanel>
                                        <ToggleSwitch x:Name="LyricVerticalToggle" Grid.Column="1" VerticalAlignment="Center"
                                                      OffContent="" OnContent="" Toggled="LyricVerticalToggle_Toggled"
                                                      ToolTipService.ToolTip="桌面歌词改为竖排（逐字纵向排列）。鼠标悬停在歌词上会出现边框，拖动右边缘可调整宽度；鼠标穿透模式下不显示边框；全屏应用（如游戏）运行时自动隐藏桌面歌词。" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- ============ 播放 ============ -->
                            <Border Style="{StaticResource SettingsCard}">
                                <StackPanel>
                                    <TextBlock Text="播放" Style="{StaticResource SettingsCardTitle}" />

                                    <Grid Padding="0,12" ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                            <TextBlock Text="歌曲封面旋转" FontSize="14" Foreground="{ThemeResource TextPrimary}" />
                                            <TextBlock Text="黑胶转动效果（歌词页封面显示为唱片）" Style="{StaticResource SettingsHint}" />
                                        </StackPanel>
                                        <ToggleSwitch x:Name="CoverSpinToggle" Grid.Column="1" VerticalAlignment="Center"
                                                      OffContent="" OnContent="" Toggled="CoverSpinToggle_Toggled" />
                                    </Grid>
                                    <Border Height="1" Background="{ThemeResource BorderSoft}" Opacity="0.5" />

                                    <Grid Padding="0,12" ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                            <TextBlock Text="动态音量" FontSize="14" Foreground="{ThemeResource TextPrimary}" />
                                            <TextBlock Text="按歌曲内嵌 ReplayGain 自动均衡响度，只应用固定增益，不会跳过歌曲结尾" Style="{StaticResource SettingsHint}" />
                                        </StackPanel>
                                        <ToggleSwitch x:Name="DynamicVolumeToggle" Grid.Column="1" VerticalAlignment="Center"
                                                      OffContent="" OnContent="" Toggled="DynamicVolumeToggle_Toggled"
                                                      ToolTipService.ToolTip="使用歌曲预先保存的 ReplayGain 响度信息，在播放时应用固定增益，不改变歌曲时间轴。" />
                                    </Grid>
                                    <Border Height="1" Background="{ThemeResource BorderSoft}" Opacity="0.5" />

                                    <Grid Padding="0,12" ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                            <TextBlock Text="音效" FontSize="14" Foreground="{ThemeResource TextPrimary}" />
                                            <TextBlock Text="均衡器 / 混响 / 环绕 / 超重低音等效果" Style="{StaticResource SettingsHint}" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="打开音效面板" Click="SoundFxOpen_Click" FontSize="12"
                                                Padding="14,6" CornerRadius="{StaticResource RadiusMedium}" VerticalAlignment="Center"
                                                Background="{ThemeResource ButtonBackground}"
                                                BorderBrush="{ThemeResource BorderSoft}" BorderThickness="1"
                                                ToolTipService.ToolTip="10 段图形均衡器与风格预设、超重低音、混响、环绕等效果" />
                                    </Grid>
                                    <Border Height="1" Background="{ThemeResource BorderSoft}" Opacity="0.5" />

                                    <Grid Padding="0,12" ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                            <TextBlock Text="定时停止播放" FontSize="14" Foreground="{ThemeResource TextPrimary}" />
                                        </StackPanel>
                                        <ComboBox x:Name="SleepTimerCombo" Grid.Column="1" Width="130" VerticalAlignment="Center"
                                                  SelectionChanged="SleepTimerCombo_SelectionChanged">
                                            <ComboBoxItem Content="关" />
                                            <ComboBoxItem Content="15 分钟" />
                                            <ComboBoxItem Content="30 分钟" />
                                            <ComboBoxItem Content="60 分钟" />
                                            <ComboBoxItem Content="90 分钟" />
                                        </ComboBox>
                                    </Grid>
                                    <Border Height="1" Background="{ThemeResource BorderSoft}" Opacity="0.5" />

                                    <Grid Padding="0,12" ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                            <TextBlock Text="淡入淡出（Crossfade）" FontSize="14" Foreground="{ThemeResource TextPrimary}" />
                                        </StackPanel>
                                        <ComboBox x:Name="CrossfadeCombo" Grid.Column="1" Width="130" VerticalAlignment="Center"
                                                  SelectionChanged="CrossfadeCombo_SelectionChanged">
                                            <ComboBoxItem Content="关" />
                                            <ComboBoxItem Content="1 秒" />
                                            <ComboBoxItem Content="2 秒" />
                                            <ComboBoxItem Content="3 秒" />
                                        </ComboBox>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- ============ 关闭行为 ============ -->
                            <Border Style="{StaticResource SettingsCard}">
                                <StackPanel>
                                    <TextBlock Text="关闭行为" Style="{StaticResource SettingsCardTitle}" />
                                    <Grid Padding="0,12" ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                            <TextBlock Text="点击窗口关闭按钮时" FontSize="14" Foreground="{ThemeResource TextPrimary}" />
                                        </StackPanel>
                                        <ComboBox x:Name="CloseActionCombo" Grid.Column="1" Width="160" VerticalAlignment="Center"
                                                  SelectionChanged="CloseActionCombo_SelectionChanged">
                                            <ComboBoxItem Content="直接退出" />
                                            <ComboBoxItem Content="最小化到托盘" />
                                        </ComboBox>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- ============ 全局快捷键 ============ -->
                            <Border Style="{StaticResource SettingsCard}">
                                <StackPanel>
                                    <TextBlock Text="全局快捷键" Style="{StaticResource SettingsCardTitle}" />
                                    <Grid Padding="0,12" ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                            <TextBlock Text="启用全局快捷键" FontSize="14" Foreground="{ThemeResource TextPrimary}" />
                                            <TextBlock Text="Ctrl+Alt+Space 播放/暂停 · Ctrl+Alt+← 上一首 · Ctrl+Alt+→ 下一首" Style="{StaticResource SettingsHint}" />
                                        </StackPanel>
                                        <ToggleSwitch x:Name="GlobalHotkeysToggle" Grid.Column="1" VerticalAlignment="Center"
                                                      OffContent="" OnContent="" Toggled="GlobalHotkeysToggle_Toggled" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- ============ 系统 ============ -->
                            <Border Style="{StaticResource SettingsCard}">
                                <StackPanel>
                                    <TextBlock Text="系统" Style="{StaticResource SettingsCardTitle}" />
                                    <Grid Padding="0,12" ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                            <TextBlock Text="开机自动启动" FontSize="14" Foreground="{ThemeResource TextPrimary}" />
                                        </StackPanel>
                                        <ToggleSwitch x:Name="AutoStartToggle" Grid.Column="1" VerticalAlignment="Center"
                                                      OffContent="" OnContent="" Toggled="AutoStartToggle_Toggled" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- ============ 数据与缓存 ============ -->
                            <Border Style="{StaticResource SettingsCard}">
                                <StackPanel>
                                    <TextBlock Text="数据与缓存" Style="{StaticResource SettingsCardTitle}" />
                                    <Grid Padding="0,12" ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="3">
                                            <TextBlock Text="数据/缓存存储位置" FontSize="14" Foreground="{ThemeResource TextPrimary}" />
                                            <TextBlock Text="自动歌单、最近播放、歌单、进度、歌词绑定。留空则使用默认 %LOCALAPPDATA%\MusicPlayer" Style="{StaticResource SettingsHint}" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBox x:Name="CacheDirBox" HorizontalAlignment="Stretch" PlaceholderText="留空使用默认位置" />
                                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,10,0,0">
                                        <Button x:Name="CacheDirBrowse" Content="浏览..." Click="CacheDirBrowse_Click" CornerRadius="{StaticResource RadiusMedium}" />
                                        <Button x:Name="CacheDirApply" Content="应用" Click="CacheDirApply_Click" CornerRadius="{StaticResource RadiusMedium}" />
                                        <Button x:Name="CacheDirReset" Content="恢复默认" Click="CacheDirReset_Click" CornerRadius="{StaticResource RadiusMedium}" />
                                    </StackPanel>
                                    <TextBlock x:Name="CacheDirStatus" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextSecondary}"
                                               Margin="0,8,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- ============ Last.fm ============ -->
                            <Border Style="{StaticResource SettingsCard}">
                                <StackPanel>
                                    <TextBlock Text="Last.fm" Style="{StaticResource SettingsCardTitle}" />
                                    <Grid Padding="0,12" ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="3">
                                            <TextBlock Text="Scrobble 播放记录" FontSize="14" Foreground="{ThemeResource TextPrimary}" />
                                            <TextBlock Text="自动将播放记录提交到 Last.fm，需要注册应用获取 API Key 和 Secret（last.fm/api/account/create）" Style="{StaticResource SettingsHint}" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBox x:Name="LastFmApiKeyBox" PlaceholderText="API Key" Margin="0,0,0,8" />
                                    <TextBox x:Name="LastFmApiSecretBox" PlaceholderText="API Secret" Margin="0,0,0,10" />
                                    <StackPanel x:Name="LastFmConnectPanel" Orientation="Horizontal" Spacing="10">
                                        <Button x:Name="LastFmConnectBtn" Content="连接 Last.fm" Click="LastFmConnectBtn_Click"
                                                CornerRadius="{StaticResource RadiusMedium}" />
                                        <TextBlock x:Name="LastFmStatus" FontSize="12" VerticalAlignment="Center"
                                                   Foreground="{ThemeResource TextSecondary}" />
                                    </StackPanel>
                                    <StackPanel x:Name="LastFmDisconnectPanel" Orientation="Horizontal" Spacing="10"
                                                Visibility="Collapsed">
                                        <TextBlock x:Name="LastFmUsernameText" FontSize="12" VerticalAlignment="Center"
                                                   Foreground="{StaticResource QqGreen}" />
                                        <Button x:Name="LastFmDisconnectBtn" Content="断开" Click="LastFmDisconnectBtn_Click"
                                                CornerRadius="{StaticResource RadiusMedium}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>

                    <!-- Lyric completion: a download-manager style queue. Every track
                         gets a row whose state updates live as the batch runs. -->
                    <Grid x:Name="LyricCompletionPanel" Visibility="Collapsed" Margin="22,6,22,14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{StaticResource SettingsCard}" Margin="0,0,0,12">
                            <StackPanel Spacing="12">
                                <Grid>
                                    <TextBlock Text="歌词补全" Style="{StaticResource SettingsCardTitle}" VerticalAlignment="Center" />
                                    <TextBlock x:Name="LyricCountText" Text="共 0 首" HorizontalAlignment="Right"
                                               VerticalAlignment="Center" FontSize="12"
                                               Foreground="{ThemeResource TextSecondary}" />
                                </Grid>
                                <ProgressBar x:Name="LyricProgressBar" Minimum="0" Maximum="1" Value="0" Height="6" />
                                <TextBlock x:Name="LyricStatusText" Text="空闲" Style="{StaticResource SettingsHint}" />
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Button x:Name="BtnLyricStart" Content="开始补全" Click="BtnLyricStart_Click"
                                            Background="{StaticResource QqGreen}" Foreground="White"
                                            CornerRadius="{StaticResource RadiusMedium}"
                                            ToolTipService.ToolTip="扫描全库，为缺歌词的曲目下载歌词，并为已有歌词补齐翻译/罗马音" />
                                    <Button x:Name="BtnLyricStop" Content="停止" Click="BtnLyricStop_Click" IsEnabled="False"
                                            CornerRadius="{StaticResource RadiusMedium}" />
                                    <Button x:Name="BtnLyricRetry" Content="重试失败项" Click="BtnLyricRetry_Click" IsEnabled="False"
                                            CornerRadius="{StaticResource RadiusMedium}"
                                            ToolTipService.ToolTip="只重跑失败或未找到的曲目，成功的不再重来" />
                                    <ComboBox x:Name="LyricFilterCombo" Width="132" SelectedIndex="0"
                                              SelectionChanged="LyricFilterCombo_SelectionChanged"
                                              ToolTipService.ToolTip="按结果过滤列表（过滤不影响补全本身）">
                                        <ComboBoxItem Content="全部" />
                                        <ComboBoxItem Content="仅失败" />
                                        <ComboBoxItem Content="仅成功" />
                                    </ComboBox>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1" Background="{ThemeResource CardBg}"
                                CornerRadius="{StaticResource RadiusLarge}"
                                BorderBrush="{ThemeResource BorderSoft}" BorderThickness="1">
                            <ListView x:Name="LyricTaskList" Background="Transparent" BorderThickness="0"
                                      SelectionMode="None" Padding="6">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Padding="4,7" RightTapped="LyricTask_RightTapped">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="26" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon Grid.Column="0" Glyph="{Binding StatusGlyph}" FontSize="14"
                                                      Foreground="{Binding StatusBrush}" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                                                <TextBlock Text="{Binding Title}" FontSize="13"
                                                           Foreground="{ThemeResource TextPrimary}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Artist}" FontSize="11"
                                                           Foreground="{ThemeResource TextSecondary}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding Detail}" FontSize="11"
                                                       Foreground="{ThemeResource TextSecondary}"
                                                       VerticalAlignment="Center" Margin="14,0,6,0" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>


                <!-- Immersive now-playing + lyrics (EchoMusic style): overlays the
                     title bar and the whole body while the floating player bar stays
                     usable underneath. Fixed dark ambience; ApplyCover retints the
                     background gradient from the artwork colours at runtime. -->
                <Grid x:Name="NowPlayingPanel" RequestedTheme="Dark"
                      Background="{ThemeResource NowPanelBg}" Visibility="Collapsed">
                    <Grid.RenderTransform>
                        <CompositeTransform x:Name="NowPanelTransform" />
                    </Grid.RenderTransform>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Top strip: exit chevron (left) + fold-cover toggle (right) -->
                    <Grid Grid.Row="0" Margin="16,14,16,0">
                        <Button x:Name="BtnExitNowPlaying" Style="{StaticResource GhostIconButtonStyle}"
                                Width="34" Height="34" Padding="0" HorizontalAlignment="Left"
                                Click="BtnExitNowPlaying_Click" ToolTipService.ToolTip="退出正在播放">
                            <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE70E;" FontSize="14"
                                      Foreground="{ThemeResource TextSecondary}" />
                        </Button>
                        <Button x:Name="BtnCollapseCover" HorizontalAlignment="Right"
                                Style="{StaticResource GhostIconButtonStyle}" Width="34" Height="34" Padding="0"
                                Click="BtnCollapseCover_Click" ToolTipService.ToolTip="收起 / 展开 封面">
                            <FontIcon FontFamily="Segoe MDL2 Assets" x:Name="CoverChevron" Glyph="&#xE74E;" FontSize="14"
                                      Foreground="{ThemeResource TextSecondary}" />
                        </Button>
                    </Grid>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Left: cover + track info. EchoMusic rounded-square by
                             default; the vinyl disc returns when cover spin is on. -->
                        <StackPanel x:Name="NowCoverColumn" Grid.Column="0" MinWidth="300" MaxWidth="340" Margin="20,0,8,0"
                                    VerticalAlignment="Center">
                            <Border x:Name="SquareCover" Width="272" Height="272" CornerRadius="20"
                                    HorizontalAlignment="Center" Margin="0,12,0,0"
                                    Background="{ThemeResource CardPlaceholder}"
                                    BorderBrush="#26ffffff" BorderThickness="1" />

                            <Grid x:Name="CoverDisc" Width="232" Height="232" Margin="0,32,0,0" HorizontalAlignment="Center" Visibility="Collapsed">
                                <Ellipse Width="232" Height="232" Fill="{ThemeResource Surface2}" Stroke="{ThemeResource BorderSoft}" StrokeThickness="2" />
                                <Ellipse x:Name="NowCoverEllipse" Width="232" Height="232" Fill="{ThemeResource Surface2}" />
                                <!-- Second layer for the cover crossfade (see ApplyCover) -->
                                <Ellipse x:Name="NowCoverEllipseB" Width="232" Height="232" Fill="{ThemeResource Surface2}" Opacity="0" />
                                <!-- Vinyl groove shimmer over the cover -->
                                <Ellipse Width="232" Height="232" IsHitTestVisible="False">
                                    <Ellipse.Fill>
                                        <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                                            <GradientStop Color="#00000000" Offset="0.55" />
                                            <GradientStop Color="#1fffffff" Offset="0.72" />
                                            <GradientStop Color="#00000000" Offset="0.82" />
                                            <GradientStop Color="#14ffffff" Offset="0.92" />
                                            <GradientStop Color="#40000000" Offset="1" />
                                        </RadialGradientBrush>
                                    </Ellipse.Fill>
                                </Ellipse>
                                <Ellipse Width="46" Height="46" Fill="{ThemeResource Surface}" Stroke="{ThemeResource BorderSoft}" StrokeThickness="2"
                                         HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Ellipse Width="10" Height="10" Fill="{StaticResource QqGreen}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>

                            <StackPanel x:Name="NowInfoPanel" HorizontalAlignment="Center" Spacing="5" Margin="12,16,12,8">
                                <TextBlock x:Name="NowTitle" Text="未在播放" FontSize="22" FontWeight="SemiBold"
                                           Foreground="{ThemeResource TextPrimary}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="320" />
                                <TextBlock x:Name="NowArtist" Text="" FontSize="13" Foreground="{ThemeResource TextSecondary}" TextAlignment="Center" />
                                <TextBlock x:Name="NowAlbum" Text="" FontSize="11" Foreground="{ThemeResource TextSecondary}" TextAlignment="Center" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Right: lyric calibration bar + scrolling lyrics -->
                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Lyric offset calibration + romaji/translation toggles -->
                            <StackPanel x:Name="LyricOffsetBar" Orientation="Horizontal" Spacing="6"
                                        HorizontalAlignment="Center" Margin="10,8,10,4">
                                <Button x:Name="BtnLyricOffsetDown" Content="-0.5s" Padding="9,3" FontSize="11" CornerRadius="{StaticResource RadiusSmall}"
                                        Click="BtnLyricOffsetDown_Click" ToolTipService.ToolTip="歌词提前 0.5 秒" />
                                <TextBlock x:Name="LyricOffsetText" Text="0.0s" FontSize="11" Foreground="{ThemeResource TextSecondary}"
                                           VerticalAlignment="Center" MinWidth="38" TextAlignment="Center" />
                                <Button x:Name="BtnLyricOffsetUp" Content="+0.5s" Padding="9,3" FontSize="11" CornerRadius="{StaticResource RadiusSmall}"
                                        Click="BtnLyricOffsetUp_Click" ToolTipService.ToolTip="歌词延后 0.5 秒" />
                                <Button x:Name="BtnLyricOffsetReset" Content="重置" Padding="9,3" FontSize="11" CornerRadius="{StaticResource RadiusSmall}"
                                        Click="BtnLyricOffsetReset_Click" />
                                <primitives:ToggleButton x:Name="LyricRomajiToggle" Content="罗马音" Padding="9,3" FontSize="11"
                                                         Style="{StaticResource AccentToggleStyle}"
                                                         CornerRadius="{StaticResource RadiusSmall}"
                                                         Checked="LyricRomajiToggle_Changed" Unchecked="LyricRomajiToggle_Changed" />
                                <primitives:ToggleButton x:Name="LyricTransToggle" Content="翻译" Padding="9,3" FontSize="11"
                                                         Style="{StaticResource AccentToggleStyle}"
                                                         CornerRadius="{StaticResource RadiusSmall}"
                                                         Checked="LyricTransToggle_Changed" Unchecked="LyricTransToggle_Changed" />
                            </StackPanel>

                            <!-- Scrollbar hidden: the view auto-centers on every line
                                 change, a visible bar only added clutter. Wheel /
                                 touch scrolling still work. -->
                            <ScrollViewer x:Name="LyricScroll" Grid.Row="1" Margin="4,2,10,12" VerticalScrollBarVisibility="Hidden">
                                <StackPanel x:Name="LyricStack" HorizontalAlignment="Center" Padding="10" />
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </Grid>

    

                <!-- Bottom transport bar: EchoMusic floating rounded card. -->
                <Grid x:Name="BottomBarHost" Grid.Row="1" Background="Transparent">
                    <Border x:Name="PlayerBarBorder" Margin="10,0,10,10" Padding="14,10,14,10"
                            Background="{ThemeResource Surface}" BorderBrush="{ThemeResource BorderSoft}"
                            BorderThickness="1" CornerRadius="14">
                        <Border.Shadow>
                            <ThemeShadow />
                        </Border.Shadow>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" MaxWidth="560" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <Button x:Name="BtnToggleNowPlaying" Background="Transparent" BorderThickness="0"
                                        HorizontalContentAlignment="Left" Padding="0"
                                        Click="BtnToggleNowPlaying_Click" ToolTipService.ToolTip="显示/隐藏 正在播放">
                                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                        <Grid Width="52" Height="52">
                                            <Border Background="{ThemeResource Surface3}" CornerRadius="10" />
                                            <FontIcon Glyph="&#xE8D6;" FontSize="14" Foreground="{ThemeResource TextSecondary}"
                                                      Opacity="0.45" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <Image x:Name="MiniCover" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Grid>
                                        <StackPanel VerticalAlignment="Center" MaxWidth="200" Spacing="2">
                                            <TextBlock x:Name="MiniTitle" Text="未在播放" FontSize="14" FontWeight="SemiBold"
                                                       Foreground="{StaticResource QqGreen}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock x:Name="MiniArtist" Text="" FontSize="11" Foreground="{ThemeResource TextSecondary}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="BtnBarFav" Style="{StaticResource GhostIconButtonStyle}"
                                        Width="34" Height="34" Padding="0" VerticalAlignment="Center"
                                        Click="BtnBarFav_Click" ToolTipService.ToolTip="收藏 / 取消收藏当前歌曲">
                                    <FontIcon x:Name="BarFavIcon" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                              Foreground="{ThemeResource TextSecondary}" Glyph="&#xE734;" />
                                </Button>
                            </StackPanel>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4" Margin="12,0,12,0">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="16">
                                    <Button x:Name="BtnPlayMode" Width="36" Height="32" Padding="0"
                                            Background="Transparent" BorderThickness="0"
                                            Click="BtnPlayMode_Click" ToolTipService.ToolTip="顺序播放">
                                        <FontIcon FontFamily="Segoe MDL2 Assets" x:Name="PlayModeIcon" Glyph="&#xE8FD;" FontSize="16" Foreground="{ThemeResource TextPrimary}" />
                                    </Button>
                                    <Button x:Name="BtnPrev" Width="38" Height="34" Background="Transparent" BorderThickness="0" Padding="0" Click="BtnPrev_Click">
                                        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE100;" FontSize="16" Foreground="{ThemeResource TextPrimary}" />
                                    </Button>
                                    <Button x:Name="BtnPlay" Style="{StaticResource CirclePlayStyle}" Click="BtnPlay_Click">
                                        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE102;" FontSize="16" />
                                    </Button>
                                    <Button x:Name="BtnNext" Width="38" Height="34" Background="Transparent" BorderThickness="0" Padding="0" Click="BtnNext_Click">
                                        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE101;" FontSize="16" Foreground="{ThemeResource TextPrimary}" />
                                    </Button>
                                    <Grid x:Name="VolumeIconArea" VerticalAlignment="Center" ToolTipService.ToolTip="音量">
                                        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE767;" FontSize="15" Foreground="{ThemeResource TextPrimary}" VerticalAlignment="Center" />
                                    </Grid>
                                    <Slider x:Name="VolumeSlider" Minimum="0" Maximum="100" Width="88"
                                            Foreground="{StaticResource QqGreen}" ValueChanged="VolumeSlider_ValueChanged"
                                            VerticalAlignment="Center" ToolTipService.ToolTip="音量" />
                                </StackPanel>
                                <Grid Margin="6,0,6,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="TimeCurrent" Text="00:00" Foreground="{ThemeResource TextSecondary}" FontSize="11" VerticalAlignment="Center" />
                                    <Slider x:Name="SeekSlider" Grid.Column="1" Minimum="0" Maximum="100" StepFrequency="0.5" Value="0"
                                            Margin="8,0,8,0" VerticalAlignment="Center" Foreground="{StaticResource QqGreen}"
                                            ValueChanged="SeekSlider_ValueChanged" />
                                    <TextBlock x:Name="TimeTotal" Grid.Column="2" Text="00:00" Foreground="{ThemeResource TextSecondary}" FontSize="11" VerticalAlignment="Center" />
                                </Grid>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" HorizontalAlignment="Right">
                                <Button x:Name="BtnSpeed" Width="44" Height="34" Padding="0"
                                        Background="Transparent" BorderThickness="0"
                                        Click="BtnSpeed_Click" ToolTipService.ToolTip="播放速度">
                                    <TextBlock x:Name="SpeedText" Text="1.0x" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{ThemeResource TextPrimary}" VerticalAlignment="Center" />
                                </Button>
                                <primitives:ToggleButton x:Name="BtnDesktopLyrics" Width="34" Height="34"
                                                         Style="{StaticResource AccentToggleStyle}" CornerRadius="17" ToolTipService.ToolTip="在桌面顶部显示歌词悬浮窗"
                                                         Checked="BtnDesktopLyrics_Checked" Unchecked="BtnDesktopLyrics_Unchecked">
                                    <TextBlock Text="词" FontSize="13" TextLineBounds="Tight" />
                                </primitives:ToggleButton>
                                <primitives:ToggleButton x:Name="BtnClickThrough" Width="34" Height="34" IsEnabled="False"
                                                         Style="{StaticResource AccentToggleStyle}" CornerRadius="17" ToolTipService.ToolTip="开启后鼠标点击会穿过歌词悬浮窗"
                                                         Checked="BtnClickThrough_Checked" Unchecked="BtnClickThrough_Unchecked">
                                    <TextBlock Text="穿" FontSize="13" TextLineBounds="Tight" />
                                </primitives:ToggleButton>
                                <Button x:Name="BtnQueueToggle" Width="44" Height="34" Padding="0"
                                        Background="Transparent" BorderThickness="0"
                                        Click="BtnQueueToggle_Click" ToolTipService.ToolTip="显示 / 隐藏播放队列">
                                    <Grid>
                                        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE142;" FontSize="15" Foreground="{ThemeResource TextPrimary}" />
                                        <Border x:Name="QueueBadge" HorizontalAlignment="Right" VerticalAlignment="Top"
                                                Margin="0,-2,-15,0" MinWidth="22" Height="14" CornerRadius="7"
                                                Background="{StaticResource QqGreen}" BorderBrush="{ThemeResource Surface}"
                                                BorderThickness="1" Padding="3,0" Visibility="Collapsed">
                                            <TextBlock x:Name="QueueBadgeText" Text="0" FontSize="8" Foreground="White"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" TextLineBounds="Tight" />
                                        </Border>
                                    </Grid>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
        </Grid>
        </Grid>

        <!-- Click-outside light-dismiss layer: sits under QueuePanel (later
                 sibling wins z-order) and covers the whole window while the
                 queue is open. -->
            <Border x:Name="QueueDismissLayer" Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Grid.ColumnSpan="3"
                    Background="Transparent" Visibility="Collapsed"
                    Tapped="QueueDismissLayer_Tapped" />

            <!-- Queue popup (floating frosted panel above the bottom bar).
                 Shows with a slide-up + fade; see ShowQueuePanel/HideQueuePanel. -->
            <Grid x:Name="QueuePanel" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                  VerticalAlignment="Bottom" HorizontalAlignment="Right"
                  Width="560" Height="340" Margin="10,0,10,0"
                  Background="{ThemeResource QueueAcrylic}" BorderBrush="{ThemeResource BorderSoft}"
                  BorderThickness="1" CornerRadius="14,14,0,0"
                  Visibility="Collapsed">
                <Grid.RenderTransform>
                    <CompositeTransform x:Name="QueuePanelTransform" />
                </Grid.RenderTransform>
            <!-- Lifted off the content behind it so the panel reads as a
                 floating layer rather than another docked strip. -->
            <Grid.Shadow>
                <ThemeShadow />
            </Grid.Shadow>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="18,10,10,8">
                <TextBlock x:Name="QueueTitle" Text="播放队列" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimary}" VerticalAlignment="Center" />
                <!-- FontIcon children instead of glyph-string content: a raw
                     &#xE10A; text glyph gets vertically clipped inside the
                     fixed-size button chrome, the FontIcon never does. -->
                <StackPanel Orientation="Horizontal" Spacing="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="BtnQueueClear" Style="{StaticResource GhostIconButtonStyle}"
                            Width="34" Height="32" Padding="0"
                            Click="BtnQueueClear_Click" ToolTipService.ToolTip="清空播放队列">
                        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE74D;" FontSize="14"
                                  Foreground="{ThemeResource TextSecondary}" />
                    </Button>
                    <Button x:Name="BtnQueueClose" Style="{StaticResource GhostIconButtonStyle}"
                            Width="34" Height="32" Padding="0"
                            Click="BtnQueueClose_Click" ToolTipService.ToolTip="关闭播放队列">
                        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE10A;" FontSize="14"
                                  Foreground="{ThemeResource TextSecondary}" />
                    </Button>
                </StackPanel>
            </Grid>
            <ListView x:Name="QueueList" Grid.Row="1" Background="Transparent" BorderThickness="0" Margin="10,0,10,10"
                      CanReorderItems="True" AllowDrop="True"
                      DragItemsStarting="QueueList_DragItemsStarting"
                      DragItemsCompleted="QueueList_DragItemsCompleted"
                      IsItemClickEnabled="True" ItemClick="QueueList_ItemClick">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="6,4" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0" Width="40" Height="40">
                                <Border Background="{ThemeResource Surface3}" CornerRadius="{StaticResource RadiusSmall}" />
                                <FontIcon Glyph="&#xE8D6;" FontSize="12" Foreground="{ThemeResource TextSecondary}"
                                          Opacity="0.45" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Image Source="{Binding Cover}" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}" FontSize="13" TextTrimming="CharacterEllipsis"
                                           Foreground="{Binding IsCurrent, Converter={StaticResource CurrentTrackBrush}, ConverterParameter={StaticResource QqGreen}}" />
                                <TextBlock Text="{Binding Artist}" Foreground="{ThemeResource TextSecondary}" FontSize="11" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" VerticalAlignment="Center" Margin="0,0,10,0"
                                       Text="{Binding Duration, Converter={StaticResource TimeSpanConverter}}" Foreground="{ThemeResource TextSecondary}" FontSize="11" />
                            <Button Grid.Column="3" Width="30" Height="28" Padding="0" VerticalAlignment="Center"
                                    Background="Transparent" BorderThickness="0"
                                    Click="QueueRemove_Click" ToolTipService.ToolTip="从播放队列中移除">
                                <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE711;" FontSize="13"
                                          Foreground="{ThemeResource TextSecondary}" />
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <!-- Playback error toast (auto-skips to the next track) -->
        <controls:InfoBar x:Name="PlayErrorBar" Grid.Row="1" Severity="Error" IsClosable="True"
                          HorizontalAlignment="Center" VerticalAlignment="Top" Margin="12,10,12,0"
                          Visibility="Visible" IsOpen="False" />

    </Grid>
</Window>
