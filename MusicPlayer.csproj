<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- MinGW toolchain for the desktop-lyrics overlay; override on machines
         where it lives elsewhere. -->
    <GxxPath Condition="'$(GxxPath)' == ''">E:\mingw\msys2\ucrt64\bin\</GxxPath>
    <OutputType>WinExe</OutputType>
    <!-- Platform 26100: matches the installed Windows Kits Platform.xml and the
         26100 projection FFmpegInteropX was compiled against; the app still
         runs on 19041+ via TargetPlatformMinVersion. -->
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <WindowsSdkPackageVersion>10.0.26100.87</WindowsSdkPackageVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <AssemblyName>MusicPlayer</AssemblyName>
    <RootNamespace>MusicPlayer</RootNamespace>
    <Version>1.6.19</Version>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <EnableDefaultItems>true</EnableDefaultItems>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <LangVersion>latest</LangVersion>
    <!-- Keep an existing publish directory across builds and publishes. -->
    <DeleteExistingFiles>false</DeleteExistingFiles>
  </PropertyGroup>

  <!-- The installer folder holds its OWN compilation units (installer/uninstall/
       Uninstall.cs is built separately by build_msi.ps1 with the .NET Framework
       csc). Exclude it from the app's default Compile glob or the app build
       fails with CS0017 (multiple entry points). -->
  <ItemGroup>
    <Compile Remove="installer\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FFmpegInteropX" Version="2.1.0.81200" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260710003" />
    <PackageReference Include="TagLibSharp" Version="2.3.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="9.0.4" />
  </ItemGroup>

  <!--
    WinUI 3 / Windows App SDK native DLLs depend on the Visual C++ runtime
    (vcruntime140.dll, vcruntime140_1.dll, msvcp140.dll). The self-contained
    Windows App SDK does NOT bundle these, so on machines without the matching
    VC++ Redistributable the process fails to load and "vanishes" silently.
    Copy the VC runtime next to the exe so the build output runs standalone.
    The copy must run for BOTH the normal build output and the publish folder.
  -->
  <Target Name="CopyVCRuntime" AfterTargets="Build">
    <ItemGroup>
      <VcDll Include="$(SystemRoot)\System32\vcruntime140.dll" />
      <VcDll Include="$(SystemRoot)\System32\vcruntime140_1.dll" />
      <VcDll Include="$(SystemRoot)\System32\msvcp140.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(VcDll)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" ContinueOnError="true" />
  </Target>

  <!--
    Trim WinUI framework MUI locale folders from build AND publish output.

    The self-contained WinUI build drops ~84 culture-named folders
    (af-ZA, de-DE, zh-CN, ...) next to the exe, each holding only the WinUI
    framework's localized .mui resources — not the app's own strings. The app
    UI is Chinese-only, so just two cultures need to stay:
      - en-us : LOAD-BEARING neutral resources (Microsoft.ui.xaml.dll.mui).
                Removing it crashes the app at startup (stowed XAML 0xC000027B).
      - zh-CN : Simplified-Chinese framework strings for Chinese systems.
    Every other culture folder is deleted right after Build (dev output) and
    again after Publish (publish copies MUI folders straight from the NuGet
    cache into $(PublishDir), so trimming $(OutDir) alone is not enough). The
    framework falls back to the en-us neutral resources for any language not
    present — fully safe. (Supersedes the manual installer/group_locales.py.)
  -->
  <PropertyGroup>
    <_LocaleKeepRegex>^(?!en-us$|zh-cn$)[a-z]{2,3}(-[a-z0-9]+)+$</_LocaleKeepRegex>
  </PropertyGroup>

  <Target Name="TrimLocaleFolders" AfterTargets="Build">
    <ItemGroup>
      <_LocaleDir Include="$([System.IO.Directory]::GetDirectories('$(OutDir)'))" />
      <_UnwantedLocale Include="@(_LocaleDir)"
                       Condition="$([System.Text.RegularExpressions.Regex]::IsMatch(
                                    $([System.IO.Path]::GetFileName('%(Identity)')),
                                    '$(_LocaleKeepRegex)',
                                    System.Text.RegularExpressions.RegexOptions.IgnoreCase))" />
    </ItemGroup>
    <RemoveDir Directories="@(_UnwantedLocale)" ContinueOnError="true" />
    <Message Text="TrimLocaleFolders: kept en-us + zh-CN, removed @(_UnwantedLocale->Count()) locale folder(s) from $(OutDir)"
             Importance="high" Condition="'@(_UnwantedLocale)' != ''" />
  </Target>

  <Target Name="TrimLocaleFoldersPublish" AfterTargets="Publish" Condition="'$(PublishDir)' != ''">
    <ItemGroup>
      <_LocaleDirPub Include="$([System.IO.Directory]::GetDirectories('$(PublishDir)'))" />
      <_UnwantedLocalePub Include="@(_LocaleDirPub)"
                          Condition="$([System.Text.RegularExpressions.Regex]::IsMatch(
                                         $([System.IO.Path]::GetFileName('%(Identity)')),
                                         '$(_LocaleKeepRegex)',
                                         System.Text.RegularExpressions.RegexOptions.IgnoreCase))" />
    </ItemGroup>
    <RemoveDir Directories="@(_UnwantedLocalePub)" ContinueOnError="true" />
    <Message Text="TrimLocaleFolders: kept en-us + zh-CN, removed @(_UnwantedLocalePub->Count()) locale folder(s) from $(PublishDir)"
             Importance="high" Condition="'@(_UnwantedLocalePub)' != ''" />
  </Target>

  <Target Name="CopyVCRuntimePublish" AfterTargets="Publish" Condition="'$(PublishDir)' != ''">
    <ItemGroup>
      <VcDllP Include="$(SystemRoot)\System32\vcruntime140.dll" />
      <VcDllP Include="$(SystemRoot)\System32\vcruntime140_1.dll" />
      <VcDllP Include="$(SystemRoot)\System32\msvcp140.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(VcDllP)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" ContinueOnError="true" />
  </Target>

  <!--
    Trim unused Windows App SDK AI/ML components from build AND publish.

    The self-contained WinAppSDK 1.8 copies its full AI/ML stack into the
    output: onnxruntime + DirectML (~38 MB) and the Windows.AI.* managed
    projections. This player never loads them, so they are deleted right
    after Build and again after Publish.

    KEPT on purpose (verified by bisecting with 0xC0000135 startup exits):
    Microsoft.Windows.Widgets.dll/.winmd/.Projection.dll and
    Microsoft.InteractiveExperiences.Projection.dll — removing any of these
    makes the self-contained bootstrapper fail with STATUS_DLL_NOT_FOUND
    even though the app never uses Widgets. They total ~4.5 MB.

    Wildcard ItemGroup includes only expand when each entry carries the
    directory prefix, so the file list is explicit (the ->'$(dir)%(Identity)'
    transform below adds the prefix). Keep in sync when upgrading the SDK.
  -->
  <PropertyGroup>
    <_TrimAiFiles>onnxruntime.dll;onnxruntime_providers_shared.dll;DirectML.dll;Microsoft.ML.OnnxRuntime.dll;Microsoft.Windows.AI.AICapabilities.dll;Microsoft.Windows.AI.ContentModerationInternal.winmd;Microsoft.Windows.AI.ContentSafety.Projection.dll;Microsoft.Windows.AI.ContentSafety.dll;Microsoft.Windows.AI.ContentSafety.winmd;Microsoft.Windows.AI.Foundation.Projection.dll;Microsoft.Windows.AI.Foundation.winmd;Microsoft.Windows.AI.FoundationInternal.winmd;Microsoft.Windows.AI.GenerativeInternal.winmd;Microsoft.Windows.AI.Imaging.Projection.dll;Microsoft.Windows.AI.Imaging.dll;Microsoft.Windows.AI.Imaging.winmd;Microsoft.Windows.AI.MachineLearning.Projection.dll;Microsoft.Windows.AI.MachineLearning.dll;Microsoft.Windows.AI.MachineLearning.winmd;Microsoft.Windows.AI.Projection.dll;Microsoft.Windows.AI.Text.Projection.dll;Microsoft.Windows.AI.Text.dll;Microsoft.Windows.AI.Text.winmd;Microsoft.Windows.AI.winmd</_TrimAiFiles>
    <_TrimAiDirs>NpuDetect;NVIDIA Corporation</_TrimAiDirs>
  </PropertyGroup>

  <Target Name="TrimUnusedComponents" AfterTargets="Build">
    <ItemGroup>
      <_TrimAiFileRaw Include="$(_TrimAiFiles)" />
      <_TrimAiFile Include="@(_TrimAiFileRaw->'$(OutDir)%(Identity)')" />
      <_TrimAiDirRaw Include="$(_TrimAiDirs)" />
      <_TrimAiDir Include="@(_TrimAiDirRaw->'$(OutDir)%(Identity)')" />
    </ItemGroup>
    <Delete Files="@(_TrimAiFile)" ContinueOnError="true" />
    <RemoveDir Directories="@(_TrimAiDir)" ContinueOnError="true" />
  </Target>

  <Target Name="TrimUnusedComponentsPublish" AfterTargets="Publish" Condition="'$(PublishDir)' != ''">
    <ItemGroup>
      <_TrimAiFilePubRaw Include="$(_TrimAiFiles)" />
      <_TrimAiFilePub Include="@(_TrimAiFilePubRaw->'$(PublishDir)%(Identity)')" />
      <_TrimAiDirPubRaw Include="$(_TrimAiDirs)" />
      <_TrimAiDirPub Include="@(_TrimAiDirPubRaw->'$(PublishDir)%(Identity)')" />
    </ItemGroup>
    <Delete Files="@(_TrimAiFilePub)" ContinueOnError="true" />
    <RemoveDir Directories="@(_TrimAiDirPub)" ContinueOnError="true" />
  </Target>

  <!--
    WORKAROUND: WinApp SDK 1.8 self-contained (unpackaged) publish silently
    drops the app's compiled XAML (.xbf) and resource index (MusicPlayer.pri)
    from the output. At startup LoadComponent then fails with
    "Cannot locate resource from 'ms-appx:///MainWindow.xaml'"
    (microsoft-ui-xaml #10876). The normal build output ($(OutDir)) contains
    them, so copy them into the publish folder next to the exe.
  -->
  <Target Name="CopyXamlResourcesPublish" AfterTargets="Publish" Condition="'$(PublishDir)' != ''">
    <ItemGroup>
      <XamlResource Include="$(OutDir)*.xbf" />
      <XamlResource Include="$(OutDir)MusicPlayer.pri" />
    </ItemGroup>
    <Copy SourceFiles="@(XamlResource)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" ContinueOnError="true" />
  </Target>

  <!--
    Build the C++ desktop-lyrics overlay (a standalone Win32 layered window
    that the WinUI app drives over a named pipe). Compiled with the MinGW-w64
    g++ that ships with this machine, statically linked so the resulting exe
    has zero runtime dependencies. The exe is dropped next to the app and
    copied into the self-contained publish folder.
  -->
  <Target Name="BuildOverlay" BeforeTargets="Build;Publish">
    <!-- No ContinueOnError: a silent compile failure shipped a stale overlay
         exe once; the build must fail loudly when g++ is unavailable. -->
    <!-- g++ needs its own bin dir on PATH for the assembler/linker it spawns;
         a bare "dotnet publish" (e.g. from a service without MSYS2 on PATH)
         used to fail here with a bare exit code 1. -->
    <Exec Command="set PATH=$(GxxPath);%25PATH%25&#x0D;&#x0A;&quot;$(GxxPath)g++.exe&quot; -O2 -static -std=c++17 -mwindows -o &quot;$(OutDir)DesktopLyricsOverlay.exe&quot; &quot;$(MSBuildProjectDirectory)\DesktopLyricsOverlay\main.cpp&quot; -ld2d1 -ldwrite -ldwmapi -lole32 -luser32 -lgdi32 -lkernel32" />
  </Target>

  <Target Name="CopyOverlayPublish" AfterTargets="Publish" Condition="'$(PublishDir)' != ''">
    <Copy SourceFiles="$(OutDir)DesktopLyricsOverlay.exe" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" ContinueOnError="true" />
  </Target>

  <!--
    QrcNative.dll — the QQ QRC 3DES block loop as a native library (ported
    1:1 from Services/QqQrcDecrypter.DesHelper; byte-identical, verified over
    random buffers). QqQrcDecrypter falls back to the managed implementation
    when the DLL is missing, so lyrics never break because of it.
  -->
  <Target Name="BuildQrcNative" BeforeTargets="Build;Publish">
    <!-- Same PATH preamble as BuildOverlay: g++ spawns sub-tools that need
         its own bin dir on PATH. -->
    <Exec Command="set PATH=$(GxxPath);%25PATH%25&#x0D;&#x0A;&quot;$(GxxPath)g++.exe&quot; -O2 -static -shared -std=c++17 -o &quot;$(OutDir)QrcNative.dll&quot; &quot;$(MSBuildProjectDirectory)\NativeQrc\qrc.cpp&quot;" />
  </Target>

  <Target Name="CopyQrcNativePublish" AfterTargets="Publish" Condition="'$(PublishDir)' != ''">
    <Copy SourceFiles="$(OutDir)QrcNative.dll" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" ContinueOnError="true" />
  </Target>

  <!-- Copy the app icon next to the exe so the runtime window-icon call
       (AppWindow.SetIcon) can find it; the embedded icon (ApplicationIcon)
       already covers the taskbar. -->
  <Target Name="CopyAppIcon" AfterTargets="Build">
    <Copy SourceFiles="$(MSBuildProjectDirectory)\Assets\AppIcon.ico" DestinationFiles="$(OutDir)AppIcon.ico" SkipUnchangedFiles="true" ContinueOnError="true" />
  </Target>

  <Target Name="CopyAppIconPublish" AfterTargets="Publish" Condition="'$(PublishDir)' != ''">
    <Copy SourceFiles="$(MSBuildProjectDirectory)\Assets\AppIcon.ico" DestinationFiles="$(PublishDir)AppIcon.ico" SkipUnchangedFiles="true" ContinueOnError="true" />
  </Target>

</Project>
