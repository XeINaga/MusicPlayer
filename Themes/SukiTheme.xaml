<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      Design tokens modelled after EchoMusic: a warm paper-white main area,
      pure-white sidebar/cards, soft borders and generous corner radii. Dark
      mode mirrors EchoMusic's graphite palette.

      Colours live in ThemeDictionaries so flipping RequestedTheme re-evaluates
      every {ThemeResource} reference in the app. Geometry (radii, padding) does
      not change between themes and keeps using {StaticResource}.

      Accent brushes are deliberately absent here. QqGreen (the runtime accent,
      name kept for compatibility) and AccentGlow stay in MainWindow's own
      resource dictionary because ApplyAccentColor() looks them up there and
      mutates their Color at runtime from the saved setting. NavSelected is also
      retinted from ApplyAccentColor(); the values below are only the fallback
      before that runs.
    -->

    <ResourceDictionary.ThemeDictionaries>

        <!-- ===================== Light (EchoMusic default) ===================== -->
        <ResourceDictionary x:Key="Light">
            <!-- Main area paper-grey, sidebar and cards pure white. -->
            <SolidColorBrush x:Key="AppBackground" Color="#f5f5f7" />
            <SolidColorBrush x:Key="Surface" Color="#ffffff" />
            <SolidColorBrush x:Key="Surface2" Color="#f2f2f5" />
            <SolidColorBrush x:Key="Surface3" Color="#ececf0" />
            <!-- Mostly opaque white for text legibility, but letting a hint
                 of the window material through. -->
            <SolidColorBrush x:Key="CardBg" Color="#f0ffffff" />
            <SolidColorBrush x:Key="BorderSoft" Color="#e5e5ea" />

            <SolidColorBrush x:Key="TextPrimary" Color="#1d1d1f" />
            <SolidColorBrush x:Key="TextSecondary" Color="#4b5563" />
            <!-- Task outcome colours for the lyric-completion list. -->
            <SolidColorBrush x:Key="TextSuccess" Color="#12a05f" />
            <SolidColorBrush x:Key="TextDanger" Color="#c62a30" />
            <SolidColorBrush x:Key="TextMuted" Color="#8a8a99" />

            <!-- Accent-tinted navigation states. -->
            <SolidColorBrush x:Key="NavHover" Color="#f0f0f2" />
            <SolidColorBrush x:Key="NavSelected" Color="#fdeaea" />
            <!-- Sidebar tint over the window material: low enough that the
                 Mica/acrylic backdrop reads through (the pane is separated
                 from the main area by its border line, not an opaque fill). -->
            <SolidColorBrush x:Key="NavRailBg" Color="#99ffffff" />

            <!-- Main-window glass: semi-transparent tint layered over the
                 system backdrop (Mica / Mica Alt / acrylic, user-selectable).
                 Only MainWindow's root uses this — secondary windows keep the
                 opaque AppBackground, since their swap chains have nothing
                 behind the transparency. -->
            <SolidColorBrush x:Key="MainGlassBg" Color="#b9f7f7fa" />

            <!-- Floating player bar: a plain translucent tint. The bar sits
                 on its own layout row with no content beneath it, so an
                 in-app AcrylicBrush has nothing to blur and (measured) never
                 picks up the backdrop — a plain brush tracks the window
                 material exactly like the sidebar does. -->
            <SolidColorBrush x:Key="BarGlass" Color="#c0ffffff" />

            <!-- List-row hover: EchoMusic's 5% ink wash. -->
            <SolidColorBrush x:Key="RowHover" Color="#0d000000" />

            <!-- Round transport play button: white disc, ink glyph, hairline. -->
            <SolidColorBrush x:Key="PlayBtnBg" Color="#ffffff" />
            <SolidColorBrush x:Key="PlayBtnBgPointerOver" Color="#f6f6f8" />
            <SolidColorBrush x:Key="PlayBtnFg" Color="#1d1d1f" />
            <SolidColorBrush x:Key="PlayBtnBorder" Color="#e5e5ea" />

            <!-- WinUI's Button template reads these, so defining them once gives
                 every button consistent hover / pressed feedback. -->
            <SolidColorBrush x:Key="ButtonBackground" Color="#ffffff" />
            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#f3f4f6" />
            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#e9eaee" />
            <SolidColorBrush x:Key="ButtonBorderBrush" Color="#e5e5ea" />
            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#c9cad2" />
            <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#b4b5c0" />
            <SolidColorBrush x:Key="ButtonForeground" Color="#1d1d1f" />
            <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#000000" />
            <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#3a3a44" />

            <LinearGradientBrush x:Key="CardPlaceholder" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#ececf0" Offset="0" />
                <GradientStop Color="#f5f5f7" Offset="1" />
            </LinearGradientBrush>

            <!-- Now-playing overlay: fixed dark ambience (cover-tinted at
                 runtime), independent of the app theme. -->
            <LinearGradientBrush x:Key="NowPanelBg" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#f2191b22" Offset="0" />
                <GradientStop Color="#f80e0f14" Offset="1" />
            </LinearGradientBrush>

            <AcrylicBrush x:Key="QueueAcrylic"
                          TintColor="#ffffff" TintOpacity="0.85" TintLuminosityOpacity="0.75"
                          FallbackColor="#fbfbfd" />
        </ResourceDictionary>

        <!-- ===================== Dark (EchoMusic graphite) ===================== -->
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="AppBackground" Color="#26262a" />
            <SolidColorBrush x:Key="Surface" Color="#e636363a" />
            <SolidColorBrush x:Key="Surface2" Color="#313135" />
            <SolidColorBrush x:Key="Surface3" Color="#3c3c41" />
            <!-- Semi-transparent graphite so the window material reads
                 through under the cards (sidebar/cards float on the glass,
                 they are not opaque slabs on top of it). -->
            <SolidColorBrush x:Key="CardBg" Color="#b436363a" />
            <SolidColorBrush x:Key="BorderSoft" Color="#3a3a3d" />

            <SolidColorBrush x:Key="TextPrimary" Color="#f5f5f7" />
            <SolidColorBrush x:Key="TextSecondary" Color="#a8b0bf" />
            <SolidColorBrush x:Key="TextSuccess" Color="#31c27c" />
            <SolidColorBrush x:Key="TextDanger" Color="#e5484d" />
            <SolidColorBrush x:Key="TextMuted" Color="#6d6d7a" />

            <SolidColorBrush x:Key="NavHover" Color="#2c2c30" />
            <SolidColorBrush x:Key="NavSelected" Color="#4a2a2c" />
            <!-- Sidebar glass tint (~33% graphite): the material shows
                 through and the pane is delimited by its border line. -->
            <SolidColorBrush x:Key="NavRailBg" Color="#54303034" />

            <!-- Main-window glass tint over the system backdrop. -->
            <SolidColorBrush x:Key="MainGlassBg" Color="#c81d1d21" />

            <!-- Floating player bar tint (~45% graphite), see Light note. -->
            <SolidColorBrush x:Key="BarGlass" Color="#73202024" />

            <SolidColorBrush x:Key="RowHover" Color="#14ffffff" />

            <SolidColorBrush x:Key="PlayBtnBg" Color="#ffffff" />
            <SolidColorBrush x:Key="PlayBtnBgPointerOver" Color="#f0f0f2" />
            <SolidColorBrush x:Key="PlayBtnFg" Color="#1d1d1f" />
            <SolidColorBrush x:Key="PlayBtnBorder" Color="#ffffff" />

            <SolidColorBrush x:Key="ButtonBackground" Color="#3c3c41" />
            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#47474d" />
            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#333338" />
            <SolidColorBrush x:Key="ButtonBorderBrush" Color="#454549" />
            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#58585f" />
            <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#4a4a52" />
            <SolidColorBrush x:Key="ButtonForeground" Color="#f5f5f7" />
            <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#ffffff" />
            <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#d8d8e0" />

            <LinearGradientBrush x:Key="CardPlaceholder" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#3c3c42" Offset="0" />
                <GradientStop Color="#2c2c31" Offset="1" />
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="NowPanelBg" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#f2191b22" Offset="0" />
                <GradientStop Color="#f80e0f14" Offset="1" />
            </LinearGradientBrush>

            <AcrylicBrush x:Key="QueueAcrylic"
                          TintColor="#2f2f34" TintOpacity="0.82" TintLuminosityOpacity="0.7"
                          FallbackColor="#2f2f34" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- Theme-independent geometry. -->
    <CornerRadius x:Key="RadiusSmall">8</CornerRadius>
    <CornerRadius x:Key="RadiusMedium">12</CornerRadius>
    <CornerRadius x:Key="RadiusLarge">16</CornerRadius>
    <CornerRadius x:Key="RadiusPill">20</CornerRadius>
    <Thickness x:Key="CardPadding">18,16</Thickness>

    <!-- Settings section card styles. Shared app-wide (MainWindow's settings
         page and the SoundEffectWindow panel) so secondary windows render
         cards identical to the main window without duplicating the styles.
         They only reference {ThemeResource} keys above, so a single
         theme-independent definition works for both themes. -->
    <Style x:Key="SettingsCard" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBg}" />
        <Setter Property="BorderBrush" Value="{ThemeResource BorderSoft}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusMedium}" />
        <Setter Property="Padding" Value="22,18" />
    </Style>

    <Style x:Key="SettingsCardTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource TextPrimary}" />
        <Setter Property="Margin" Value="0,0,0,14" />
    </Style>

    <Style x:Key="SettingsHint" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource TextSecondary}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
</ResourceDictionary>
