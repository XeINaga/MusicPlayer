<Window
    x:Class="MusicPlayer.WallpaperLibraryWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="选择 Wallpaper Engine 壁纸">

    <Grid x:Name="Root" Background="{ThemeResource AppBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" Margin="16,12,16,8">
            <TextBox x:Name="SearchBox" MinWidth="220" MinHeight="32" FontSize="12"
                     PlaceholderText="搜索标题…" TextChanged="SearchBox_TextChanged" />
            <TextBlock x:Name="CountText" VerticalAlignment="Center" FontSize="12"
                       Foreground="{ThemeResource TextSecondary}" />
        </StackPanel>

        <ListView x:Name="WallpaperList" Grid.Row="1" Margin="16,0,16,8"
                  Background="Transparent" BorderThickness="0"
                  SelectionMode="Single" IsDoubleTapEnabled="True"
                  DoubleTapped="WallpaperList_DoubleTapped">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="12" Margin="4,4">
                        <Border Width="72" Height="42" CornerRadius="6" Background="{ThemeResource Surface3}"
                                BorderBrush="{ThemeResource BorderSoft}" BorderThickness="1">
                            <Image Source="{Binding PreviewSource}" Stretch="UniformToFill" />
                        </Border>
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="{Binding Title}" FontSize="13" MaxLines="1"
                                       TextTrimming="CharacterEllipsis" MaxWidth="420"
                                       Foreground="{ThemeResource TextPrimary}" />
                            <TextBlock FontSize="11" Foreground="{ThemeResource TextSecondary}">
                                <Run Text="{Binding TypeDisplay}" /> · <Run Text="{Binding Resolution}" />
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="16,8,16,16">
            <Button Content="取消" Click="Cancel_Click" MinWidth="100" MinHeight="32" />
            <Button x:Name="OkBtn" Content="应用壁纸" Click="Ok_Click" MinWidth="110" MinHeight="32"
                    Background="{ThemeResource ButtonBackground}" BorderBrush="{ThemeResource ButtonBorderBrush}"
                    BorderThickness="1" />
        </StackPanel>
    </Grid>
</Window>
