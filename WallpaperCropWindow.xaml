<Window
    x:Class="MusicPlayer.WallpaperCropWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="裁剪壁纸">

    <Grid x:Name="Root" Background="{ThemeResource AppBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Toolbar: source info, ratio selector, reset, live crop size -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="14" Margin="16,10,16,6" VerticalAlignment="Center">
            <TextBlock x:Name="SrcText" VerticalAlignment="Center" FontSize="12"
                       Foreground="{ThemeResource TextSecondary}" />
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock Text="比例" VerticalAlignment="Center" FontSize="13"
                           Foreground="{ThemeResource TextPrimary}" />
                <ComboBox x:Name="RatioCombo" MinWidth="118" MinHeight="30" FontSize="12"
                          SelectionChanged="RatioCombo_SelectionChanged">
                    <ComboBoxItem Content="窗口比例" IsSelected="True" />
                    <ComboBoxItem Content="16:9" />
                    <ComboBoxItem Content="4:3" />
                    <ComboBoxItem Content="3:2" />
                    <ComboBoxItem Content="1:1" />
                    <ComboBoxItem Content="自由" />
                </ComboBox>
            </StackPanel>
            <Button x:Name="ResetBtn" Content="重置框选" MinWidth="88" MinHeight="30" FontSize="12" Click="Reset_Click" />
            <TextBlock x:Name="HintText" VerticalAlignment="Center" FontSize="12"
                       Foreground="{ThemeResource TextSecondary}" />
        </StackPanel>

        <Canvas x:Name="CanvasHost" Grid.Row="1" Margin="16,4,16,4" Background="{ThemeResource Surface2}">
            <Image x:Name="PreviewImage" />
            <Rectangle x:Name="MaskTop" Fill="#66000000" IsHitTestVisible="False" />
            <Rectangle x:Name="MaskBottom" Fill="#66000000" IsHitTestVisible="False" />
            <Rectangle x:Name="MaskLeft" Fill="#66000000" IsHitTestVisible="False" />
            <Rectangle x:Name="MaskRight" Fill="#66000000" IsHitTestVisible="False" />
            <Border x:Name="CropFrame" BorderBrush="{ThemeResource TextPrimary}" BorderThickness="2"
                    Background="Transparent" PointerPressed="OnPointerPressed"
                    PointerMoved="OnPointerMoved" PointerReleased="OnPointerReleased">
                <!-- rule-of-thirds guides -->
                <Grid IsHitTestVisible="False">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Rectangle Grid.Row="0" Grid.ColumnSpan="3" Height="1" VerticalAlignment="Bottom"
                               Fill="#48FFFFFF" />
                    <Rectangle Grid.Row="1" Grid.ColumnSpan="3" Height="1" VerticalAlignment="Bottom"
                               Fill="#48FFFFFF" />
                    <Rectangle Grid.Column="0" Grid.RowSpan="3" Width="1" HorizontalAlignment="Right"
                               Fill="#48FFFFFF" />
                    <Rectangle Grid.Column="1" Grid.RowSpan="3" Width="1" HorizontalAlignment="Right"
                               Fill="#48FFFFFF" />
                </Grid>
            </Border>
            <Border x:Name="HandleTL" Width="16" Height="16" CornerRadius="3" Background="{ThemeResource TextPrimary}"
                    PointerPressed="OnPointerPressed" PointerMoved="OnPointerMoved" PointerReleased="OnPointerReleased" />
            <Border x:Name="HandleTR" Width="16" Height="16" CornerRadius="3" Background="{ThemeResource TextPrimary}"
                    PointerPressed="OnPointerPressed" PointerMoved="OnPointerMoved" PointerReleased="OnPointerReleased" />
            <Border x:Name="HandleBL" Width="16" Height="16" CornerRadius="3" Background="{ThemeResource TextPrimary}"
                    PointerPressed="OnPointerPressed" PointerMoved="OnPointerMoved" PointerReleased="OnPointerReleased" />
            <Border x:Name="HandleBR" Width="16" Height="16" CornerRadius="3" Background="{ThemeResource TextPrimary}"
                    PointerPressed="OnPointerPressed" PointerMoved="OnPointerMoved" PointerReleased="OnPointerReleased" />
        </Canvas>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="16,4,16,16">
            <Button Content="取消" Click="Cancel_Click" MinWidth="100" MinHeight="32" />
            <Button x:Name="OkBtn" Content="确定裁剪" Click="Ok_Click" MinWidth="100" MinHeight="32"
                    Background="{ThemeResource ButtonBackground}" BorderBrush="{ThemeResource ButtonBorderBrush}"
                    BorderThickness="1" />
        </StackPanel>
    </Grid>
</Window>
